:7.0,"color":"#283858","ls":1.3,"after":4.2},"poem":{"font":"LAi","size":6.75,"color":"#283858","ls":1.18,"stanza":3.71},"source":{"font":"LAi","size":5.8,"color":"#5E6A83","ls":1.0,"before":4.06}},{"t":"text","bind":"in_memory","x":0.24,"y":3.4,"w":2.02,"h":0.1094,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":6.3,"color":"#5E6A83","spc":0.0},{"t":"text","bind":"name","x":0.24,"y":3.5294,"w":2.02,"h":0.1738,"anchor":"m","sample":"Miriam Ruth Goldstein","align":"c","ls":0.95,"font":"PF","size":9.2,"color":"#1B2A4A","spc":0.0},{"t":"text","bind":"dates","x":0.24,"y":3.7232,"w":2.02,"h":0.1392,"anchor":"m","sample":"March 4, 1941 – September 12, 2026","align":"c","ls":1.1,"font":"LA","size":6.2,"color":"#283858","spc":0.2}],"bg":"cm-bg-jewish-25-jew_blue-back.jpg","px":[750,1275]}],"jew_gold":[{"design":"jew_gold","side":"front","w":2.5,"h":4.25,"els":[{"t":"text","bind":"kicker","x":0.15,"y":0.24,"w":2.2,"h":0.44,"anchor":"m","sample":"In Loving Memory","align":"c","ls":1.0,"font":"GV","size":17.0,"color":"#8A7340","spc":0.0},{"t":"photo","bind":"photo","x":0.52,"y":0.72,"w":1.46,"h":1.7844,"border":"#B8955A","bw":0.75},{"t":"text","bind":"name","x":0.22,"y":2.6044,"w":2.06,"h":0.44,"anchor":"m","sample":"David Samuel Katz","align":"c","ls":0.92,"font":"PF","size":12.5,"color":"#2A2926","spc":0.0},{"t":"text","bind":"dates","x":0.22,"y":3.0844,"w":2.06,"h":0.15,"anchor":"m","sample":"June 12, 1948 – September 10, 2026","align":"c","ls":1.15,"font":"LA","size":6.8,"color":"#3A3733","spc":0.2}],"bg":"cm-bg-jewish-25-jew_gold-front.jpg","px":[750,1275]},{"design":"jew_gold","side":"back","w":2.5,"h":4.25,"els":[{"t":"text","bind":"verse_title","x":0.15,"y":0.5,"w":2.2,"h":0.26,"anchor":"m","sample":"Mourner’s Kaddish","align":"c","ls":1.0,"font":"PF","size":10.5,"color":"#8A7340","spc":0.0},{"t":"verse","bind":"verse","x":0.24,"y":0.78,"w":2.02,"h":2.58,"anchor":"m","sample":"Yitgadal v’yitkadash sh’mei raba, b’alma di v’ra chirutei, v’yamlich malchutei b’chayeichon uv’yomeichon uv’chayei d’chol beit Yisrael, ba’agala uvizman kariv, v’imru: Amen.\nY’hei sh’mei raba m’varach l’alam ul’almei almaya.\nOseh shalom bimromav, hu ya’aseh shalom aleinu v’al kol Yisrael, v’imru: Amen.\nMay God’s great name be exalted and sanctified in the world created according to the divine will. May the One who makes peace in the heavens make peace for us and for all Israel. Amen.\nTraditional, with an English rendering","align":"c","ls":1.3,"font":"LA","size":7.0,"color":"#3A3733","spc":0.0,"prose":{"font":"LA","size":7.0,"color":"#3A3733","ls":1.3,"after":4.2},"poem":{"font":"LAi","size":6.75,"color":"#3A3733","ls":1.18,"stanza":3.71},"source":{"font":"LAi","size":5.8,"color":"#6E675C","ls":1.0,"before":4.06}},{"t":"text","bind":"in_memory","x":0.24,"y":3.4,"w":2.02,"h":0.1094,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":6.3,"color":"#6E675C","spc":0.0},{"t":"text","bind":"name","x":0.24,"y":3.5294,"w":2.02,"h":0.1738,"anchor":"m","sample":"David Samuel Katz","align":"c","ls":0.95,"font":"PF","size":9.2,"color":"#2A2926","spc":0.0},{"t":"text","bind":"dates","x":0.24,"y":3.7232,"w":2.02,"h":0.1392,"anchor":"m","sample":"June 12, 1948 – September 10, 2026","align":"c","ls":1.1,"font":"LA","size":6.2,"color":"#3A3733","spc":0.2}],"bg":"cm-bg-jewish-25-jew_gold-back.jpg","px":[750,1275]}],"jew_sage":[{"design":"jew_sage","side":"front","w":2.5,"h":4.25,"els":[{"t":"text","bind":"kicker","x":0.15,"y":0.24,"w":2.2,"h":0.44,"anchor":"m","sample":"Of Blessed Memory","align":"c","ls":1.0,"font":"GV","size":16.06,"color":"#5F7249","spc":0.0},{"t":"photo","bind":"photo","x":0.52,"y":0.72,"w":1.46,"h":1.7844,"border":"#8A9A6A","bw":0.75},{"t":"text","bind":"name","x":0.22,"y":2.6044,"w":2.06,"h":0.44,"anchor":"m","sample":"Miriam Ruth Goldstein","align":"c","ls":0.92,"font":"PF","size":12.5,"color":"#2F3A2C","spc":0.0},{"t":"text","bind":"dates","x":0.22,"y":3.0844,"w":2.06,"h":0.15,"anchor":"m","sample":"March 4, 1941 – September 12, 2026","align":"c","ls":1.15,"font":"LA","size":6.8,"color":"#343E32","spc":0.2}],"bg":"cm-bg-jewish-25-jew_sage-front.jpg","px":[750,1275]},{"design":"jew_sage","side":"back","w":2.5,"h":4.25,"els":[{"t":"text","bind":"verse_title","x":0.15,"y":0.5,"w":2.2,"h":0.26,"anchor":"m","sample":"El Malei Rachamim","align":"c","ls":1.0,"font":"PF","size":10.5,"color":"#5A6B45","spc":0.0},{"t":"verse","bind":"verse","x":0.24,"y":0.78,"w":2.02,"h":2.58,"anchor":"m","sample":"God, full of mercy, who dwells on high, grant perfect rest beneath the sheltering wings of Your presence, among the holy and the pure who shine like the brightness of the heavens, to the soul of her who has gone to her eternal home.\nSource of mercy, shelter her forever in the shadow of Your wings, and bind her soul in the bond of life. The Eternal is her inheritance; may she rest in peace. And let us say: Amen.\nThe memorial prayer, English rendering","align":"c","ls":1.3,"font":"LA","size":7.0,"color":"#343E32","spc":0.0,"prose":{"font":"LA","size":7.0,"color":"#343E32","ls":1.3,"after":4.2},"poem":{"font":"LAi","size":6.75,"color":"#343E32","ls":1.18,"stanza":3.71},"source":{"font":"LAi","size":5.8,"color":"#68725E","ls":1.0,"before":4.06}},{"t":"text","bind":"in_memory","x":0.24,"y":3.4,"w":2.02,"h":0.1094,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":6.3,"color":"#68725E","spc":0.0},{"t":"text","bind":"name","x":0.24,"y":3.5294,"w":2.02,"h":0.1738,"anchor":"m","sample":"Miriam Ruth Goldstein","align":"c","ls":0.95,"font":"PF","size":9.2,"color":"#2F3A2C","spc":0.0},{"t":"text","bind":"dates","x":0.24,"y":3.7232,"w":2.02,"h":0.1392,"anchor":"m","sample":"March 4, 1941 – September 12, 2026","align":"c","ls":1.1,"font":"LA","size":6.2,"color":"#343E32","spc":0.2}],"bg":"cm-bg-jewish-25-jew_sage-back.jpg","px":[750,1275]}],"jew_navy":[{"design":"jew_navy","side":"front","w":2.5,"h":4.25,"els":[{"t":"text","bind":"kicker","x":0.15,"y":0.24,"w":2.2,"h":0.44,"anchor":"m","sample":"Always Remembered","align":"c","ls":1.0,"font":"GV","size":15.11,"color":"#1E2A44","spc":0.0},{"t":"photo","bind":"photo","x":0.52,"y":0.72,"w":1.46,"h":1.7844,"border":"#B39457","bw":0.75},{"t":"text","bind":"name","x":0.22,"y":2.6044,"w":2.06,"h":0.44,"anchor":"m","sample":"David Samuel Katz","align":"c","ls":0.92,"font":"PF","size":12.5,"color":"#1E2A44","spc":0.0},{"t":"text","bind":"dates","x":0.22,"y":3.0844,"w":2.06,"h":0.15,"anchor":"m","sample":"June 12, 1948 – September 10, 2026","align":"c","ls":1.15,"font":"LA","size":6.8,"color":"#2C3650","spc":0.2}],"bg":"cm-bg-jewish-25-jew_navy-front.jpg","px":[750,1275]},{"design":"jew_navy","side":"back","w":2.5,"h":4.25,"els":[{"t":"text","bind":"verse_title","x":0.15,"y":0.5,"w":2.2,"h":0.26,"anchor":"m","sample":"Psalm 121 · תהילים קכ״א","align":"c","ls":1.0,"font":"PF","size":10.5,"color":"#1E2A44","spc":0.0},{"t":"verse","bind":"verse","x":0.24,"y":0.78,"w":2.02,"h":2.58,"anchor":"m","sample":"I will lift up mine eyes unto the mountains: from whence shall my help come? My help cometh from the LORD, who made heaven and earth. He will not suffer thy foot to be moved; He that keepeth thee will not slumber. Behold, He that keepeth Israel doth neither slumber nor sleep.\nThe LORD is thy keeper; the LORD is thy shade upon thy right hand. The sun shall not smite thee by day, nor the moon by night. The LORD shall keep thee from all evil; He shall keep thy soul. The LORD shall guard thy going out and thy coming in, from this time forth and for ever.\nPsalm 121, JPS 1917","align":"c","ls":1.3,"font":"LA","size":7.0,"color":"#2C3650","spc":0.0,"prose":{"font":"LA","size":7.0,"color":"#2C3650","ls":1.3,"after":4.2},"poem":{"font":"LAi","size":6.75,"color":"#2C3650","ls":1.18,"stanza":3.71},"source":{"font":"LAi","size":5.8,"color":"#5F6882","ls":1.0,"before":4.06}},{"t":"text","bind":"in_memory","x":0.24,"y":3.4,"w":2.02,"h":0.1094,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":6.3,"color":"#5F6882","spc":0.0},{"t":"text","bind":"name","x":0.24,"y":3.5294,"w":2.02,"h":0.1738,"anchor":"m","sample":"David Samuel Katz","align":"c","ls":0.95,"font":"PF","size":9.2,"color":"#1E2A44","spc":0.0},{"t":"text","bind":"dates","x":0.24,"y":3.7232,"w":2.02,"h":0.1392,"anchor":"m","sample":"June 12, 1948 – September 10, 2026","align":"c","ls":1.1,"font":"LA","size":6.2,"color":"#2C3650","spc":0.2}],"bg":"cm-bg-jewish-25-jew_navy-back.jpg","px":[750,1275]}],"jew_lavender":[{"design":"jew_lavender","side":"front","w":2.5,"h":4.25,"els":[{"t":"text","bind":"kicker","x":0.15,"y":0.24,"w":2.2,"h":0.44,"anchor":"m","sample":"Forever in Our Hearts","align":"c","ls":1.0,"font":"GV","size":15.58,"color":"#6E5F94","spc":0.0},{"t":"photo","bind":"photo","x":0.52,"y":0.72,"w":1.46,"h":1.7844,"border":"#9A8BC2","bw":0.75},{"t":"text","bind":"name","x":0.22,"y":2.6044,"w":2.06,"h":0.44,"anchor":"m","sample":"Miriam Ruth Goldstein","align":"c","ls":0.92,"font":"PF","size":12.5,"color":"#2F2A3D","spc":0.0},{"t":"text","bind":"dates","x":0.22,"y":3.0844,"w":2.06,"h":0.15,"anchor":"m","sample":"March 4, 1941 – September 12, 2026","align":"c","ls":1.15,"font":"LA","size":6.8,"color":"#3A3448","spc":0.2}],"bg":"cm-bg-jewish-25-jew_lavender-front.jpg","px":[750,1275]},{"design":"jew_lavender","side":"back","w":2.5,"h":4.25,"els":[{"t":"text","bind":"verse_title","x":0.15,"y":0.5,"w":2.2,"h":0.26,"anchor":"m","sample":"Eishet Chayil · אשת חיל","align":"c","ls":1.0,"font":"PF","size":10.5,"color":"#6B5B8E","spc":0.0},{"t":"verse","bind":"verse","x":0.24,"y":0.78,"w":2.02,"h":2.58,"anchor":"m","sample":"A woman of valour who can find? for her price is far above rubies. The heart of her husband doth safely trust in her, and he hath no lack of gain. She doeth him good and not evil all the days of her life.\nStrength and dignity are her clothing; and she laugheth at the time to come. She openeth her mouth with wisdom; and the law of kindness is on her tongue. Her children rise up, and call her blessed. Grace is deceitful, and beauty is vain; but a woman that feareth the LORD, she shall be praised.\nProverbs 31:10-12, 25-26, 28, 30, JPS 1917","align":"c","ls":1.3,"font":"LA","size":7.0,"color":"#3A3448","spc":0.0,"prose":{"font":"LA","size":7.0,"color":"#3A3448","ls":1.3,"after":4.2},"poem":{"font":"LAi","size":6.75,"color":"#3A3448","ls":1.18,"stanza":3.71},"source":{"font":"LAi","size":5.8,"color":"#6E6880","ls":1.0,"before":4.06}},{"t":"text","bind":"in_memory","x":0.24,"y":3.4,"w":2.02,"h":0.1094,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":6.3,"color":"#6E6880","spc":0.0},{"t":"text","bind":"name","x":0.24,"y":3.5294,"w":2.02,"h":0.1738,"anchor":"m","sample":"Miriam Ruth Goldstein","align":"c","ls":0.95,"font":"PF","size":9.2,"color":"#2F2A3D","spc":0.0},{"t":"text","bind":"dates","x":0.24,"y":3.7232,"w":2.02,"h":0.1392,"anchor":"m","sample":"March 4, 1941 – September 12, 2026","align":"c","ls":1.1,"font":"LA","size":6.2,"color":"#3A3448","spc":0.2}],"bg":"cm-bg-jewish-25-jew_lavender-back.jpg","px":[750,1275]}],"jew_grey":[{"design":"jew_grey","side":"front","w":2.5,"h":4.25,"els":[{"t":"text","bind":"kicker","x":0.15,"y":0.24,"w":2.2,"h":0.44,"anchor":"m","sample":"In Memory","align":"c","ls":1.0,"font":"GV","size":17.94,"color":"#4A4A4A","spc":0.0},{"t":"photo","bind":"photo","x":0.52,"y":0.72,"w":1.46,"h":1.7844,"border":"#8C8C8C","bw":0.75},{"t":"text","bind":"name","x":0.22,"y":2.6044,"w":2.06,"h":0.44,"anchor":"m","sample":"Miriam Ruth Goldstein","align":"c","ls":0.92,"font":"PF","size":12.5,"color":"#2A2A2A","spc":0.0},{"t":"text","bind":"dates","x":0.22,"y":3.0844,"w":2.06,"h":0.15,"anchor":"m","sample":"March 4, 1941 – September 12, 2026","align":"c","ls":1.15,"font":"LA","size":6.8,"color":"#3A3A3A","spc":0.2}],"bg":"cm-bg-jewish-25-jew_grey-front.jpg","px":[750,1275]},{"design":"jew_grey","side":"back","w":2.5,"h":4.25,"els":[{"t":"text","bind":"verse_title","x":0.15,"y":0.5,"w":2.2,"h":0.26,"anchor":"m","sample":"Yizkor · יזכור","align":"c","ls":1.0,"font":"PF","size":10.5,"color":"#4A4A4A","spc":0.0},{"t":"verse","bind":"verse","x":0.24,"y":0.78,"w":2.02,"h":2.58,"anchor":"m","sample":"May God remember the soul of her who has gone to her eternal home. In loving testimony to her life, we pledge charity to help perpetuate the ideals important to her.\nThrough such deeds, and through prayer and remembrance, may her soul be bound up in the bond of life. May she be at peace, and may her memory be a blessing. Zichrono livracha · ז״ל\nThe memorial prayer, English rendering","align":"c","ls":1.3,"font":"LA","size":7.0,"color":"#3A3A3A","spc":0.0,"prose":{"font":"LA","size":7.0,"color":"#3A3A3A","ls":1.3,"after":4.2},"poem":{"font":"LAi","size":6.75,"color":"#3A3A3A","ls":1.18,"stanza":3.71},"source":{"font":"LAi","size":5.8,"color":"#707070","ls":1.0,"before":4.06}},{"t":"text","bind":"in_memory","x":0.24,"y":3.4,"w":2.02,"h":0.1094,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":6.3,"color":"#707070","spc":0.0},{"t":"text","bind":"name","x":0.24,"y":3.5294,"w":2.02,"h":0.1738,"anchor":"m","sample":"Miriam Ruth Goldstein","align":"c","ls":0.95,"font":"PF","size":9.2,"color":"#2A2A2A","spc":0.0},{"t":"text","bind":"dates","x":0.24,"y":3.7232,"w":2.02,"h":0.1392,"anchor":"m","sample":"March 4, 1941 – September 12, 2026","align":"c","ls":1.1,"font":"LA","size":6.2,"color":"#3A3A3A","spc":0.2}],"bg":"cm-bg-jewish-25-jew_grey-back.jpg","px":[750,1275]}]},"46":{"jew_blue":[{"design":"jew_blue","side":"front","w":4.0,"h":6.0,"els":[{"t":"text","bind":"kicker","x":0.2,"y":0.36,"w":3.6,"h":0.62,"anchor":"m","sample":"May Her Memory Be a Blessing","align":"c","ls":1.0,"font":"GV","size":17.33,"color":"#2F4F9E","spc":0.0},{"t":"photo","bind":"photo","x":0.85,"y":1.06,"w":2.3,"h":2.8111,"border":"#8BA3D6","bw":1.0},{"t":"text","bind":"name","x":0.35,"y":4.0111,"w":3.3,"h":0.62,"anchor":"m","sample":"Miriam Ruth Goldstein","align":"c","ls":0.92,"font":"PF","size":19.0,"color":"#1B2A4A","spc":0.0},{"t":"text","bind":"dates","x":0.35,"y":4.6911,"w":3.3,"h":0.21,"anchor":"m","sample":"March 4, 1941 – September 12, 2026","align":"c","ls":1.15,"font":"LA","size":9.5,"color":"#283858","spc":0.2}],"bg":"cm-bg-jewish-46-jew_blue-front.jpg","px":[1200,1800]},{"design":"jew_blue","side":"back","w":4.0,"h":6.0,"els":[{"t":"text","bind":"verse_title","x":0.2,"y":0.76,"w":3.6,"h":0.36,"anchor":"m","sample":"Psalm 23 · תהילים כ״ג","align":"c","ls":1.0,"font":"PF","size":15.0,"color":"#2F4F9E","spc":0.0},{"t":"verse","bind":"verse","x":0.38,"y":1.18,"w":3.24,"h":3.5,"anchor":"m","sample":"The LORD is my shepherd; I shall not want. He maketh me to lie down in green pastures; He leadeth me beside the still waters. He restoreth my soul; He guideth me in straight paths for His name’s sake. Yea, though I walk through the valley of the shadow of death, I will fear no evil, for Thou art with me; Thy rod and Thy staff, they comfort me. Thou preparest a table before me in the presence of mine enemies; Thou hast anointed my head with oil; my cup runneth over. Surely goodness and mercy shall follow me all the days of my life; and I shall dwell in the house of the LORD for ever.\nPsalm 23, JPS 1917","align":"c","ls":1.3,"font":"LA","size":10.2,"color":"#283858","spc":0.0,"prose":{"font":"LA","size":10.2,"color":"#283858","ls":1.3,"after":6.12},"poem":{"font":"LAi","size":9.6,"color":"#283858","ls":1.18,"stanza":5.28},"source":{"font":"LAi","size":8,"color":"#5E6A83","ls":1.0,"before":5.6}},{"t":"text","bind":"in_memory","x":0.38,"y":4.78,"w":3.24,"h":0.1562,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":9.0,"color":"#5E6A83","spc":0.0},{"t":"text","bind":"name","x":0.38,"y":4.9562,"w":3.24,"h":0.2456,"anchor":"m","sample":"Miriam Ruth Goldstein","align":"c","ls":0.95,"font":"PF","size":13.0,"color":"#1B2A4A","spc":0.0},{"t":"text","bind":"dates","x":0.38,"y":5.2218,"w":3.24,"h":0.1892,"anchor":"m","sample":"March 4, 1941 – September 12, 2026","align":"c","ls":1.1,"font":"LA","size":8.6,"color":"#283858","spc":0.2}],"bg":"cm-bg-jewish-46-jew_blue-back.jpg","px":[1200,1800]}],"jew_gold":[{"design":"jew_gold","side":"front","w":4.0,"h":6.0,"els":[{"t":"text","bind":"kicker","x":0.2,"y":0.36,"w":3.6,"h":0.62,"anchor":"m","sample":"In Loving Memory","align":"c","ls":1.0,"font":"GV","size":26.0,"color":"#8A7340","spc":0.0},{"t":"photo","bind":"photo","x":0.85,"y":1.06,"w":2.3,"h":2.8111,"border":"#B8955A","bw":1.0},{"t":"text","bind":"name","x":0.35,"y":4.0111,"w":3.3,"h":0.62,"anchor":"m","sample":"David Samuel Katz","align":"c","ls":0.92,"font":"PF","size":19.0,"color":"#2A2926","spc":0.0},{"t":"text","bind":"dates","x":0.35,"y":4.6911,"w":3.3,"h":0.21,"anchor":"m","sample":"June 12, 1948 – September 10, 2026","align":"c","ls":1.15,"font":"LA","size":9.5,"color":"#3A3733","spc":0.2}],"bg":"cm-bg-jewish-46-jew_gold-front.jpg","px":[1200,1800]},{"design":"jew_gold","side":"back","w":4.0,"h":6.0,"els":[{"t":"text","bind":"verse_title","x":0.2,"y":0.76,"w":3.6,"h":0.36,"anchor":"m","sample":"Mourner’s Kaddish","align":"c","ls":1.0,"font":"PF","size":15.0,"color":"#8A7340","spc":0.0},{"t":"verse","bind":"verse","x":0.38,"y":1.18,"w":3.24,"h":3.5,"anchor":"m","sample":"Yitgadal v’yitkadash sh’mei raba, b’alma di v’ra chirutei, v’yamlich malchutei b’chayeichon uv’yomeichon uv’chayei d’chol beit Yisrael, ba’agala uvizman kariv, v’imru: Amen.\nY’hei sh’mei raba m’varach l’alam ul’almei almaya.\nOseh shalom bimromav, hu ya’aseh shalom aleinu v’al kol Yisrael, v’imru: Amen.\nMay God’s great name be exalted and sanctified in the world created according to the divine will. May the One who makes peace in the heavens make peace for us and for all Israel. Amen.\nTraditional, with an English rendering","align":"c","ls":1.3,"font":"LA","size":10.2,"color":"#3A3733","spc":0.0,"prose":{"font":"LA","size":10.2,"color":"#3A3733","ls":1.3,"after":6.12},"poem":{"font":"LAi","size":9.6,"color":"#3A3733","ls":1.18,"stanza":5.28},"source":{"font":"LAi","size":8,"color":"#6E675C","ls":1.0,"before":5.6}},{"t":"text","bind":"in_memory","x":0.38,"y":4.78,"w":3.24,"h":0.1562,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":9.0,"color":"#6E675C","spc":0.0},{"t":"text","bind":"name","x":0.38,"y":4.9562,"w":3.24,"h":0.2456,"anchor":"m","sample":"David Samuel Katz","align":"c","ls":0.95,"font":"PF","size":13.0,"color":"#2A2926","spc":0.0},{"t":"text","bind":"dates","x":0.38,"y":5.2218,"w":3.24,"h":0.1892,"anchor":"m","sample":"June 12, 1948 – September 10, 2026","align":"c","ls":1.1,"font":"LA","size":8.6,"color":"#3A3733","spc":0.2}],"bg":"cm-bg-jewish-46-jew_gold-back.jpg","px":[1200,1800]}],"jew_sage":[{"design":"jew_sage","side":"front","w":4.0,"h":6.0,"els":[{"t":"text","bind":"kicker","x":0.2,"y":0.36,"w":3.6,"h":0.62,"anchor":"m","sample":"Of Blessed Memory","align":"c","ls":1.0,"font":"GV","size":24.56,"color":"#5F7249","spc":0.0},{"t":"photo","bind":"photo","x":0.85,"y":1.06,"w":2.3,"h":2.8111,"border":"#8A9A6A","bw":1.0},{"t":"text","bind":"name","x":0.35,"y":4.0111,"w":3.3,"h":0.62,"anchor":"m","sample":"Miriam Ruth Goldstein","align":"c","ls":0.92,"font":"PF","size":19.0,"color":"#2F3A2C","spc":0.0},{"t":"text","bind":"dates","x":0.35,"y":4.6911,"w":3.3,"h":0.21,"anchor":"m","sample":"March 4, 1941 – September 12, 2026","align":"c","ls":1.15,"font":"LA","size":9.5,"color":"#343E32","spc":0.2}],"bg":"cm-bg-jewish-46-jew_sage-front.jpg","px":[1200,1800]},{"design":"jew_sage","side":"back","w":4.0,"h":6.0,"els":[{"t":"text","bind":"verse_title","x":0.2,"y":0.76,"w":3.6,"h":0.36,"anchor":"m","sample":"El Malei Rachamim","align":"c","ls":1.0,"font":"PF","size":15.0,"color":"#5A6B45","spc":0.0},{"t":"verse","bind":"verse","x":0.38,"y":1.18,"w":3.24,"h":3.5,"anchor":"m","sample":"God, full of mercy, who dwells on high, grant perfect rest beneath the sheltering wings of Your presence, among the holy and the pure who shine like the brightness of the heavens, to the soul of her who has gone to her eternal home.\nSource of mercy, shelter her forever in the shadow of Your wings, and bind her soul in the bond of life. The Eternal is her inheritance; may she rest in peace. And let us say: Amen.\nThe memorial prayer, English rendering","align":"c","ls":1.3,"font":"LA","size":10.2,"color":"#343E32","spc":0.0,"prose":{"font":"LA","size":10.2,"color":"#343E32","ls":1.3,"after":6.12},"poem":{"font":"LAi","size":9.6,"color":"#343E32","ls":1.18,"stanza":5.28},"source":{"font":"LAi","size":8,"color":"#68725E","ls":1.0,"before":5.6}},{"t":"text","bind":"in_memory","x":0.38,"y":4.78,"w":3.24,"h":0.1562,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":9.0,"color":"#68725E","spc":0.0},{"t":"text","bind":"name","x":0.38,"y":4.9562,"w":3.24,"h":0.2456,"anchor":"m","sample":"Miriam Ruth Goldstein","align":"c","ls":0.95,"font":"PF","size":13.0,"color":"#2F3A2C","spc":0.0},{"t":"text","bind":"dates","x":0.38,"y":5.2218,"w":3.24,"h":0.1892,"anchor":"m","sample":"March 4, 1941 – September 12, 2026","align":"c","ls":1.1,"font":"LA","size":8.6,"color":"#343E32","spc":0.2}],"bg":"cm-bg-jewish-46-jew_sage-back.jpg","px":[1200,1800]}],"jew_navy":[{"design":"jew_navy","side":"front","w":4.0,"h":6.0,"els":[{"t":"text","bind":"kicker","x":0.2,"y":0.36,"w":3.6,"h":0.62,"anchor":"m","sample":"Always Remembered","align":"c","ls":1.0,"font":"GV","size":23.11,"color":"#1E2A44","spc":0.0},{"t":"photo","bind":"photo","x":0.85,"y":1.06,"w":2.3,"h":2.8111,"border":"#B39457","bw":1.0},{"t":"text","bind":"name","x":0.35,"y":4.0111,"w":3.3,"h":0.62,"anchor":"m","sample":"David Samuel Katz","align":"c","ls":0.92,"font":"PF","size":19.0,"color":"#1E2A44","spc":0.0},{"t":"text","bind":"dates","x":0.35,"y":4.6911,"w":3.3,"h":0.21,"anchor":"m","sample":"June 12, 1948 – September 10, 2026","align":"c","ls":1.15,"font":"LA","size":9.5,"color":"#2C3650","spc":0.2}],"bg":"cm-bg-jewish-46-jew_navy-front.jpg","px":[1200,1800]},{"design":"jew_navy","side":"back","w":4.0,"h":6.0,"els":[{"t":"text","bind":"verse_title","x":0.2,"y":0.76,"w":3.6,"h":0.36,"anchor":"m","sample":"Psalm 121 · תהילים קכ״א","align":"c","ls":1.0,"font":"PF","size":15.0,"color":"#1E2A44","spc":0.0},{"t":"verse","bind":"verse","x":0.38,"y":1.18,"w":3.24,"h":3.5,"anchor":"m","sample":"I will lift up mine eyes unto the mountains: from whence shall my help come? My help cometh from the LORD, who made heaven and earth. He will not suffer thy foot to be moved; He that keepeth thee will not slumber. Behold, He that keepeth Israel doth neither slumber nor sleep.\nThe LORD is thy keeper; the LORD is thy shade upon thy right hand. The sun shall not smite thee by day, nor the moon by night. The LORD shall keep thee from all evil; He shall keep thy soul. The LORD shall guard thy going out and thy coming in, from this time forth and for ever.\nPsalm 121, JPS 1917","align":"c","ls":1.3,"font":"LA","size":10.2,"color":"#2C3650","spc":0.0,"prose":{"font":"LA","size":10.2,"color":"#2C3650","ls":1.3,"after":6.12},"poem":{"font":"LAi","size":9.6,"color":"#2C3650","ls":1.18,"stanza":5.28},"source":{"font":"LAi","size":8,"color":"#5F6882","ls":1.0,"before":5.6}},{"t":"text","bind":"in_memory","x":0.38,"y":4.78,"w":3.24,"h":0.1562,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":9.0,"color":"#5F6882","spc":0.0},{"t":"text","bind":"name","x":0.38,"y":4.9562,"w":3.24,"h":0.2456,"anchor":"m","sample":"David Samuel Katz","align":"c","ls":0.95,"font":"PF","size":13.0,"color":"#1E2A44","spc":0.0},{"t":"text","bind":"dates","x":0.38,"y":5.2218,"w":3.24,"h":0.1892,"anchor":"m","sample":"June 12, 1948 – September 10, 2026","align":"c","ls":1.1,"font":"LA","size":8.6,"color":"#2C3650","spc":0.2}],"bg":"cm-bg-jewish-46-jew_navy-back.jpg","px":[1200,1800]}],"jew_lavender":[{"design":"jew_lavender","side":"front","w":4.0,"h":6.0,"els":[{"t":"text","bind":"kicker","x":0.2,"y":0.36,"w":3.6,"h":0.62,"anchor":"m","sample":"Forever in Our Hearts","align":"c","ls":1.0,"font":"GV","size":23.83,"color":"#6E5F94","spc":0.0},{"t":"photo","bind":"photo","x":0.85,"y":1.06,"w":2.3,"h":2.8111,"border":"#9A8BC2","bw":1.0},{"t":"text","bind":"name","x":0.35,"y":4.0111,"w":3.3,"h":0.62,"anchor":"m","sample":"Miriam Ruth Goldstein","align":"c","ls":0.92,"font":"PF","size":19.0,"color":"#2F2A3D","spc":0.0},{"t":"text","bind":"dates","x":0.35,"y":4.6911,"w":3.3,"h":0.21,"anchor":"m","sample":"March 4, 1941 – September 12, 2026","align":"c","ls":1.15,"font":"LA","size":9.5,"color":"#3A3448","spc":0.2}],"bg":"cm-bg-jewish-46-jew_lavender-front.jpg","px":[1200,1800]},{"design":"jew_lavender","side":"back","w":4.0,"h":6.0,"els":[{"t":"text","bind":"verse_title","x":0.2,"y":0.76,"w":3.6,"h":0.36,"anchor":"m","sample":"Eishet Chayil · אשת חיל","align":"c","ls":1.0,"font":"PF","size":15.0,"color":"#6B5B8E","spc":0.0},{"t":"verse","bind":"verse","x":0.38,"y":1.18,"w":3.24,"h":3.5,"anchor":"m","sample":"A woman of valour who can find? for her price is far above rubies. The heart of her husband doth safely trust in her, and he hath no lack of gain. She doeth him good and not evil all the days of her life.\nStrength and dignity are her clothing; and she laugheth at the time to come. She openeth her mouth with wisdom; and the law of kindness is on her tongue. Her children rise up, and call her blessed. Grace is deceitful, and beauty is vain; but a woman that feareth the LORD, she shall be praised.\nProverbs 31:10-12, 25-26, 28, 30, JPS 1917","align":"c","ls":1.3,"font":"LA","size":10.2,"color":"#3A3448","spc":0.0,"prose":{"font":"LA","size":10.2,"color":"#3A3448","ls":1.3,"after":6.12},"poem":{"font":"LAi","size":9.6,"color":"#3A3448","ls":1.18,"stanza":5.28},"source":{"font":"LAi","size":8,"color":"#6E6880","ls":1.0,"before":5.6}},{"t":"text","bind":"in_memory","x":0.38,"y":4.78,"w":3.24,"h":0.1562,"ancho