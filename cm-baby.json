":2.02,"h":2.58,"anchor":"m","sample":"For thou hast possessed my reins: thou hast covered me in my mother’s womb. I will praise thee; for I am fearfully and wonderfully made: marvellous are thy works; and that my soul knoweth right well.\nMy substance was not hid from thee, when I was made in secret. Thine eyes did see my substance, yet being unperfect; and in thy book all my members were written, which in continuance were fashioned, when as yet there was none of them.\nPsalm 139:13-16, King James Version","align":"c","ls":1.3,"font":"LA","size":7.0,"color":"#3A3448","spc":0.0,"prose":{"font":"LA","size":7.0,"color":"#3A3448","ls":1.3,"after":4.2},"poem":{"font":"LAi","size":6.75,"color":"#3A3448","ls":1.18,"stanza":3.71},"source":{"font":"LAi","size":5.8,"color":"#6E6880","ls":1.0,"before":4.06}},{"t":"text","bind":"in_memory","x":0.24,"y":3.4,"w":2.02,"h":0.1094,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":6.3,"color":"#6E6880","spc":0.0},{"t":"text","bind":"name","x":0.24,"y":3.5294,"w":2.02,"h":0.1738,"anchor":"m","sample":"Olivia Rose Bennett","align":"c","ls":0.95,"font":"PF","size":9.2,"color":"#2F2A3D","spc":0.0},{"t":"text","bind":"dates","x":0.24,"y":3.7232,"w":2.02,"h":0.1392,"anchor":"m","sample":"Born into Heaven September 12, 2026","align":"c","ls":1.1,"font":"LA","size":6.2,"color":"#3A3448","spc":0.2}],"bg":"cm-bg-baby-25-baby_lavender-back.jpg","px":[750,1275]}],"baby_gold":[{"design":"baby_gold","side":"front","w":2.5,"h":4.25,"els":[{"t":"text","bind":"kicker","x":0.15,"y":0.24,"w":2.2,"h":0.44,"anchor":"m","sample":"Loved Beyond Words","align":"c","ls":1.0,"font":"GV","size":14.17,"color":"#8A7340","spc":0.0},{"t":"photo","bind":"photo","x":0.52,"y":0.72,"w":1.46,"h":1.7844,"border":"#B8955A","bw":0.75},{"t":"text","bind":"name","x":0.22,"y":2.6044,"w":2.06,"h":0.44,"anchor":"m","sample":"Noah James Carter","align":"c","ls":0.92,"font":"PF","size":12.5,"color":"#2A2926","spc":0.0},{"t":"text","bind":"dates","x":0.22,"y":3.0844,"w":2.06,"h":0.15,"anchor":"m","sample":"June 3 – June 12, 2026","align":"c","ls":1.15,"font":"LA","size":6.8,"color":"#3A3733","spc":0.2}],"bg":"cm-bg-baby-25-baby_gold-front.jpg","px":[750,1275]},{"design":"baby_gold","side":"back","w":2.5,"h":4.25,"els":[{"t":"text","bind":"verse_title","x":0.15,"y":0.5,"w":2.2,"h":0.26,"anchor":"m","sample":"I Shall Go to Him","align":"c","ls":1.0,"font":"PF","size":10.5,"color":"#8A7340","spc":0.0},{"t":"verse","bind":"verse","x":0.24,"y":0.78,"w":2.02,"h":2.58,"anchor":"m","sample":"But now he is dead, wherefore should I fast? can I bring him back again? I shall go to him, but he shall not return to me.\nAnd God shall wipe away all tears from their eyes; and there shall be no more death, neither sorrow, nor crying, neither shall there be any more pain: for the former things are passed away.\n2 Samuel 12:23 · Revelation 21:4, King James Version","align":"c","ls":1.3,"font":"LA","size":7.0,"color":"#3A3733","spc":0.0,"prose":{"font":"LA","size":7.0,"color":"#3A3733","ls":1.3,"after":4.2},"poem":{"font":"LAi","size":6.75,"color":"#3A3733","ls":1.18,"stanza":3.71},"source":{"font":"LAi","size":5.8,"color":"#6E675C","ls":1.0,"before":4.06}},{"t":"text","bind":"in_memory","x":0.24,"y":3.4,"w":2.02,"h":0.1094,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":6.3,"color":"#6E675C","spc":0.0},{"t":"text","bind":"name","x":0.24,"y":3.5294,"w":2.02,"h":0.1738,"anchor":"m","sample":"Noah James Carter","align":"c","ls":0.95,"font":"PF","size":9.2,"color":"#2A2926","spc":0.0},{"t":"text","bind":"dates","x":0.24,"y":3.7232,"w":2.02,"h":0.1392,"anchor":"m","sample":"June 3 – June 12, 2026","align":"c","ls":1.1,"font":"LA","size":6.2,"color":"#3A3733","spc":0.2}],"bg":"cm-bg-baby-25-baby_gold-back.jpg","px":[750,1275]}],"baby_sage":[{"design":"baby_sage","side":"front","w":2.5,"h":4.25,"els":[{"t":"text","bind":"kicker","x":0.15,"y":0.24,"w":2.2,"h":0.44,"anchor":"m","sample":"Carried in Our Hearts","align":"c","ls":1.0,"font":"GV","size":13.22,"color":"#5F7249","spc":0.0},{"t":"photo","bind":"photo","x":0.52,"y":0.72,"w":1.46,"h":1.7844,"border":"#8A9A6A","bw":0.75},{"t":"text","bind":"name","x":0.22,"y":2.6044,"w":2.06,"h":0.44,"anchor":"m","sample":"Olivia Rose Bennett","align":"c","ls":0.92,"font":"PF","size":12.5,"color":"#2F3A2C","spc":0.0},{"t":"text","bind":"dates","x":0.22,"y":3.0844,"w":2.06,"h":0.15,"anchor":"m","sample":"Born into Heaven September 12, 2026","align":"c","ls":1.15,"font":"LA","size":6.8,"color":"#343E32","spc":0.2}],"bg":"cm-bg-baby-25-baby_sage-front.jpg","px":[750,1275]},{"design":"baby_sage","side":"back","w":2.5,"h":4.25,"els":[{"t":"text","bind":"verse_title","x":0.15,"y":0.5,"w":2.2,"h":0.26,"anchor":"m","sample":"A Little While","align":"c","ls":1.0,"font":"PF","size":10.5,"color":"#5A6B45","spc":0.0},{"t":"verse","bind":"verse","x":0.24,"y":0.78,"w":2.02,"h":2.58,"anchor":"m","sample":"We did not get the years we planned,\nthe first steps or the schoolyard gate;\nwe got a heartbeat and a name,\nand love that would not, could not wait.\nSo short a while, so whole a love:\nit fills the house, it fills the sky.\nYou were, and are, and always will be\nours, little one. We don’t say goodbye.\nWritten for this card","align":"c","ls":1.18,"font":"LAi","size":6.75,"color":"#343E32","spc":0.0,"prose":{"font":"LA","size":7.0,"color":"#343E32","ls":1.3,"after":4.2},"poem":{"font":"LAi","size":6.75,"color":"#343E32","ls":1.18,"stanza":3.71},"source":{"font":"LAi","size":5.8,"color":"#68725E","ls":1.0,"before":4.06}},{"t":"text","bind":"in_memory","x":0.24,"y":3.4,"w":2.02,"h":0.1094,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":6.3,"color":"#68725E","spc":0.0},{"t":"text","bind":"name","x":0.24,"y":3.5294,"w":2.02,"h":0.1738,"anchor":"m","sample":"Olivia Rose Bennett","align":"c","ls":0.95,"font":"PF","size":9.2,"color":"#2F3A2C","spc":0.0},{"t":"text","bind":"dates","x":0.24,"y":3.7232,