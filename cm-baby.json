8,"font":"LAi","size":9.6,"color":"#2B3A4F","spc":0.0,"prose":{"font":"LA","size":10.2,"color":"#2B3A4F","ls":1.3,"after":6.12},"poem":{"font":"LAi","size":9.6,"color":"#2B3A4F","ls":1.18,"stanza":5.28},"source":{"font":"LAi","size":8,"color":"#5D6D80","ls":1.0,"before":5.6}},{"t":"text","bind":"in_memory","x":0.38,"y":4.78,"w":3.24,"h":0.1562,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":9.0,"color":"#5D6D80","spc":0.0},{"t":"text","bind":"name","x":0.38,"y":4.9562,"w":3.24,"h":0.2456,"anchor":"m","sample":"Noah James Carter","align":"c","ls":0.95,"font":"PF","size":13.0,"color":"#1F3450","spc":0.0},{"t":"text","bind":"dates","x":0.38,"y":5.2218,"w":3.24,"h":0.1892,"anchor":"m","sample":"June 3 – June 12, 2026","align":"c","ls":1.1,"font":"LA","size":8.6,"color":"#2B3A4F","spc":0.2}],"bg":"cm-bg-baby-46-baby_sky-back.jpg","px":[1200,1800]}],"baby_rose":[{"design":"baby_rose","side":"front","w":4.0,"h":6.0,"els":[{"t":"text","bind":"kicker","x":0.2,"y":0.36,"w":3.6,"h":0.62,"anchor":"m","sample":"Our Little Angel","align":"c","ls":1.0,"font":"GV","size":23.11,"color":"#A86F6F","spc":0.0},{"t":"photo","bind":"photo","x":0.85,"y":1.06,"w":2.3,"h":2.8111,"border":"#C4908E","bw":1.0},{"t":"text","bind":"name","x":0.35,"y":4.0111,"w":3.3,"h":0.62,"anchor":"m","sample":"Olivia Rose Bennett","align":"c","ls":0.92,"font":"PF","size":19.0,"color":"#3A383B","spc":0.0},{"t":"text","bind":"dates","x":0.35,"y":4.6911,"w":3.3,"h":0.21,"anchor":"m","sample":"Born into Heaven September 12, 2026","align":"c","ls":1.15,"font":"LA","size":9.5,"color":"#3E3B3F","spc":0.2}],"bg":"cm-bg-baby-46-baby_rose-front.jpg","px":[1200,1800]},{"design":"baby_rose","side":"back","w":4.0,"h":6.0,"els":[{"t":"text","bind":"verse_title","x":0.2,"y":0.76,"w":3.6,"h":0.36,"anchor":"m","sample":"Suffer the Little Children","align":"c","ls":1.0,"font":"PF","size":15.0,"color":"#A0696A","spc":0.0},{"t":"verse","bind":"verse","x":0.38,"y":1.18,"w":3.24,"h":3.5,"anchor":"m","sample":"But Jesus said, Suffer little children, and forbid them not, to come unto me: for of such is the kingdom of heaven.\nHe shall feed his flock like a shepherd: he shall gather the lambs with his arm, and carry them in his bosom, and shall gently lead those that are with young.\nMatthew 19:14 · Isaiah 40:11, King James Version","align":"c","ls":1.3,"font":"LA","size":10.2,"color":"#3E3B3F","spc":0.0,"prose":{"font":"LA","size":10.2,"color":"#3E3B3F","ls":1.3,"after":6.12},"poem":{"font":"LAi","size":9.6,"color":"#3E3B3F","ls":1.18,"stanza":5.28},"source":{"font":"LAi","size":8,"color":"#7A6D6F","ls":1.0,"before":5.6}},{"t":"text","bind":"in_memory","x":0.38,"y":4.78,"w":3.24,"h":0.1562,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":9.0,"color":"#7A6D6F","spc":0.0},{"t":"text","bind":"name","x":0.38,"y":4.9562,"w":3.24,"h":0.2456,"anchor":"m","sample":"Olivia Rose Bennett","align":"c","ls":0.95,"font":"PF","size":13.0,"color":"#3A383B","spc":0.0},{"t":"text","bind":"dates","x":0.38,"y":5.2218,"w":3.24,"h":0.1892,"anchor":"m","sample":"Born into Heaven September 12, 2026","align":"c","ls":1.1,"font":"LA","size":8.6,"color":"#3E3B3F","spc":0.2}],"bg":"cm-bg-baby-46-baby_rose-back.jpg","px":[1200,1800]}],"baby_lavender":[{"design":"baby_lavender","side":"front","w":4.0,"h":6.0,"els":[{"t":"text","bind":"kicker","x":0.2,"y":0.36,"w":3.6,"h":0.62,"anchor":"m","sample":"Forever Our Baby","align":"c","ls":1.0,"font":"GV","size":23.11,"color":"#6E5F94","spc":0.0},{"t":"photo","bind":"photo","x":0.85,"y":1.06,"w":2.3,"h":2.8111,"border":"#9A8BC2","bw":1.0},{"t":"text","bind":"name","x":0.35,"y":4.0111,"w":3.3,"h":0.62,"anchor":"m","sample":"Olivia Rose Bennett","align":"c","ls":0.92,"font":"PF","size":19.0,"color":"#2F2A3D","spc":0.0},{"t":"text","bind":"dates","x":0.35,"y":4.6911,"w":3.3,"h":0.21,"anchor":"m","sample":"Born into Heaven September 12, 2026","align":"c","ls":1.15,"font":"LA","size":9.5,"color":"#3A3448","spc":0.2}],"bg":"cm-bg-baby-46-baby_lavender-front.jpg","px":[1200,1800]},{"design":"baby_lavender","side":"back","w":4.0,"h":6.0,"els":[{"t":"text","bind":"verse_title","x":0.2,"y":0.76,"w":3.6,"h":0.36,"anchor":"m","sample":"Fearfully and Wonderfully Made","align":"c","ls":1.0,"font":"PF","size":15.0,"color":"#6B5B8E","spc":0.0},{"t":"verse","bind":"verse","x":0.38,"y":1.18,"w":3.24,"h":3.5,"anchor":"m","sample":"For thou hast possessed my reins: thou hast covered me in my mother’s womb. I will praise thee; for I am fearfully and wonderfully made: marvellous are thy works; and that my soul knoweth right well.\nMy substance was not hid from thee, when I was made in secret. Thine eyes did see my substance, yet being unperfect; and in thy book all my members were written, which in continuance were fashioned, when as yet there was none of them.\nPsalm 139:13-16, King James Version","align":"c","ls":1.3,"font":"LA","size":10.2,"color":"#3A3448","spc":0.0,"prose":{"font":"LA","size":10.2,"color":"#3A3448","ls":1.3,"after":6.12},"poem":{"font":"LAi","size":9.6,"color":"#3A3448","ls":1.18,"stanza":5.28},"source":{"font":"LAi","size":8,"color":"#6E6880","ls":1.0,"before":5.6}},{"t":"text","bind":"in_memory","x":0.38,"y":4.78,"w":3.24,"h":0.1562,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":9.0,"color":"#6E6880","spc":0.0},{"t":"text","bind":"name","x":0.38,"y":4.9562,"w":3.24,"h":0.2456,"anchor":"m","sample":"Olivia Rose Bennett","align":"c","ls":0.95,"font":"PF","size":13.0,"color":"#2F2A3D","spc":0.0},{"t":"text","bind":"dates","x":0.38,"y":5.2218,"w":3.24,"h":0.1892,"anchor":"m","sample":"Born into Heaven September 12, 2026","align":"c","ls":1.1,"font":"LA","size":8.6,"color":"#3A3448","spc":0.2}],"bg":"cm-bg-baby-46-baby_lavender-back.jpg","px":[1200,1800]}],"baby_gold":[{"design":"baby_gold","side":"front","w":4.0,"h":6.0,"els":[{"t":"text","bind":"kicker","x":0.2,"y":0.36,"w":3.6,"h":0.62,"anchor":"m","sample":"Loved Beyond Words","align":"c","ls":1.0,"font":"GV","size":21.67,"color":"#8A7340","spc":0.0},{"t":"photo","bind":"photo","x":0.85,"y":1.06,"w":2.3,"h":2.8111,"border":"#B8955A","bw":1.0},{"t":"text","bind":"name","x":0.35,"y":4.0111,"w":3.3,"h":0.62,"anchor":"m","sample":"Noah James Carter","align":"c","ls":0.92,"font":"PF","size":19.0,"color":"#2A2926","spc":0.0},{"t":"text","bind":"dates","x":0.35,"y":4.6911,"w":3.3,"h":0.21,"anchor":"m","sample":"June 3 – June 12, 2026","align":"c","ls":1.15,"font":"LA","size":9.5,"color":"#3A3733","spc":0.2}],"bg":"cm-bg-baby-46-baby_gold-front.jpg","px":[1200,1800]},{"design":"baby_gold","side":"back","w":4.0,"h":6.0,"els":[{"t":"text","bind":"verse_title","x":0.2,"y":0.76,"w":3.6,"h":0.36,"anchor":"m","sample":"I Shall Go to Him","align":"c","ls":1.0,"font":"PF","size":15.0,"color":"#8A7340","spc":0.0},{"t":"verse","bind":"verse","x":0.38,"y":1.18,"w":3.24,"h":3.5,"anchor":"m","sample":"But now he is dead, wherefore should I fast? can I bring him back again? I shall go to him, but he shall not return to me.\nAnd God shall wipe away all tears from their eyes; and there shall be no more death, neither sorrow, nor crying, neither shall there be any more pain: for the former things are passed away.\n2 Samuel 12:23 · Revelation 21:4, King James Version","align":"c","ls":1.3,"font":"LA","size":10.2,"color":"#3A3733","spc":0.0,"prose":{"font":"LA","size":10.2,"color":"#3A3733","ls":1.3,"after":6.12},"poem":{"font":"LAi","size":9.6,"color":"#3A3733","ls":1.18,"stanza":5.28},"source":{"font":"LAi","size":8,"color":"#6E675C","ls":1.0,"before":5.6}},{"t":"text","bind":"in_memory","x":0.38,"y":4.78,"w":3.24,"h":0.1562,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":9.0,"color":"#6E675C","spc":0.0},{"t":"text","bind":"name","x":0.38,"y":4.9562,"w":3.24,"h":0.2456,"anchor":"m","sample":"Noah James Carter","align":"c","ls":0.95,"font":"PF","size":13.0,"color":"#2A2926","spc":0.0},{"t":"text","bind":"dates","x":0.38,"y":5.2218,