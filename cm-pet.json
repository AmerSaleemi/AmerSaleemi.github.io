ac-back.jpg","px":[750,1275]}]},"46":{"pet_honey":[{"design":"pet_honey","side":"front","w":4.0,"h":6.0,"els":[{"t":"text","bind":"kicker","x":0.2,"y":0.36,"w":3.6,"h":0.62,"anchor":"m","sample":"Forever in Our Hearts","align":"c","ls":1.0,"font":"GV","size":23.83,"color":"#9A7640","spc":0.0},{"t":"photo","bind":"photo","x":0.85,"y":1.06,"w":2.3,"h":2.8111,"border":"#C2954F","bw":1.0},{"t":"text","bind":"name","x":0.35,"y":4.0111,"w":3.3,"h":0.62,"anchor":"m","sample":"Buddy","align":"c","ls":0.92,"font":"PF","size":19.0,"color":"#4A3A28","spc":0.0},{"t":"text","bind":"dates","x":0.35,"y":4.6911,"w":3.3,"h":0.21,"anchor":"m","sample":"April 14, 2012 – September 20, 2026","align":"c","ls":1.15,"font":"LA","size":9.5,"color":"#4E4234","spc":0.2}],"bg":"cm-bg-pet-46-pet_honey-front.jpg","px":[1200,1800]},{"design":"pet_honey","side":"back","w":4.0,"h":6.0,"els":[{"t":"text","bind":"verse_title","x":0.2,"y":0.76,"w":3.6,"h":0.36,"anchor":"m","sample":"A Faithful Friend","align":"c","ls":1.0,"font":"PF","size":15.0,"color":"#8A6A3C","spc":0.0},{"t":"verse","bind":"verse","x":0.38,"y":1.18,"w":3.24,"h":3.5,"anchor":"m","sample":"You met us at the door each day\nwith all the joy you had to give;\nyou asked for nothing but our love\nand taught us how to simply live.\nThe house is quieter tonight,\nyour collar resting on the shelf;\nbut every room still holds your light,\nand love like yours outlasts itself.","align":"c","ls":1.18,"font":"LAi","size":9.6,"color":"#4E4234","spc":0.0,"prose":{"font":"LA","size":10.2,"color":"#4E4234","ls":1.3,"after":6.12},"poem":{"font":"LAi","size":9.6,"color":"#4E4234","ls":1.18,"stanza":5.28},"source":{"font":"LAi","size":8,"color":"#7A6B58","ls":1.0,"before":5.6}},{"t":"text","bind":"in_memory","x":0.38,"y":4.78,"w":3.24,"h":0.1562,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":9.0,"color":"#7A6B58","spc":0.0},{"t":"text","bind":"name","x":0.38,"y":4.9562,"w":3.24,"h":0.2456,"anchor":"m","sample":"Buddy","align":"c","ls":0.95,"font":"PF","size":13.0,"color":"#4A3A28","spc":0.0},{"t":"text","bind":"dates","x":0.38,"y":5.2218,"w":3.24,"h":0.1892,"anchor":"m","sample":"April 14, 2012 – September 20, 2026","align":"c","ls":1.1,"font":"LA","size":8.6,"color":"#4E4234","spc":0.2}],"bg":"cm-bg-pet-46-pet_honey-back.jpg","px":[1200,1800]}],"pet_sky":[{"design":"pet_sky","side":"front","w":4.0,"h":6.0,"els":[{"t":"text","bind":"kicker","x":0.2,"y":0.36,"w":3.6,"h":0.62,"anchor":"m","sample":"Until We Meet Again","align":"c","ls":1.0,"font":"GV","size":24.56,"color":"#4A76A2","spc":0.0},{"t":"photo","bind":"photo","x":0.85,"y":1.06,"w":2.3,"h":2.8111,"border":"#7FA4CA","bw":1.0},{"t":"text","bind":"name","x":0.35,"y":4.0111,"w":3.3,"h":0.62,"anchor":"m","sample":"Daisy","align":"c","ls":0.92,"font":"PF","size":19.0,"color":"#1F3450","spc":0.0},{"t":"text","bind":"dates","x":0.35,"y":4.6911,"w":3.3,"h":0.21,"anchor":"m","sample":"June 2, 2014 – September 8, 2026","align":"c","ls":1.15,"font":"LA","size":9.5,"color":"#2B3A4F","spc":0.2}],"bg":"cm-bg-pet-46-pet_sky-front.jpg","px":[1200,1800]},{"design":"pet_sky","side":"back","w":4.0,"h":6.0,"els":[{"t":"text","bind":"verse_title","x":0.2,"y":0.76,"w":3.6,"h":0.36,"anchor":"m","sample":"Until We Meet Again","align":"c","ls":1.0,"font":"PF","size":15.0,"color":"#3E6893","spc":0.0},{"t":"verse","bind":"verse","x":0.38,"y":1.18,"w":3.24,"h":3.5,"anchor":"m","sample":"Run free now where the grass is tall,\nwhere every path leads somewhere new;\nno leash, no fence, no closing door,\nand all the sky belongs to you.\nSave us a place beside you there,\nand listen for our step, and then\ncome bounding down the hill to meet us\nwhen it is time to meet again.","align":"c","ls":1.18,"font":"LAi","size":9.6,"color":"#2B3A4F","spc":0.0,"prose":{"font":"LA","size":10.2,"color":"#2B3A4F","ls":1.3,"after":6.12},"poem":{"font":"LAi","size":9.6,"color":"#2B3A4F","ls":1.18,"stanza":5.28},"source":{"font":"LAi","size":8,"color":"#5D6D80","ls":1.0,"before":5.6}},{"t":"text","bind":"in_memory","x":0.38,"y":4.78,"w":3.24,"h":0.1562,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":9.0,"color":"#5D6D80","spc":0.0},{"t":"text","bind":"name","x":0.38,"y":4.9562,"w":3.24,"h":0.2456,"anchor":"m","sample":"Daisy","align":"c","ls":0.95,"font":"PF","size":13.0,"color":"#1F3450","spc":0.0},{"t":"text","bind":"dates","x":0.38,"y":5.2218,"w":3.24,"h":0.1892,"anchor":"m","sample":"June 2, 2014 – September 8, 2026","align":"c","ls":1.1,"font":"LA","size":8.6,"color":"#2B3A4F","spc":0.2}],"bg":"cm-bg-pet-46-pet_sky-back.jpg","px":[1200,1800]}],"pet_meadow":[{"design":"pet_meadow","side":"front","w":4.0,"h":6.0,"els":[{"t":"text","bind":"kicker","x":0.2,"y":0.36,"w":3.6,"h":0.62,"anchor":"m","sample":"A Faithful Friend","align":"c","ls":1.0,"font":"GV","size":26.0,"color":"#5A7A62","spc":0.0},{"t":"photo","bind":"photo","x":0.85,"y":1.06,"w":2.3,"h":2.8111,"border":"#86A382","bw":1.0},{"t":"text","bind":"name","x":0.35,"y":4.0111,"w":3.3,"h":0.62,"anchor":"m","sample":"Max","align":"c","ls":0.92,"font":"PF","size":19.0,"color":"#2F4034","spc":0.0},{"t":"text","bind":"dates","x":0.35,"y":4.6911,"w":3.3,"h":0.21,"anchor":"m","sample":"October 30, 2011 – August 29, 2026","align":"c","ls":1.15,"font":"LA","size":9.5,"color":"#33403A","spc":0.2}],"bg":"cm-bg-pet-46-pet_meadow-front.jpg","px":[1200,1800]},{"design":"pet_meadow","side":"back","w":4.0,"h":6.0,"els":[{"t":"text","bind":"verse_title","x":0.2,"y":0.76,"w":3.6,"h":0.36,"anchor":"m","sample":"Epitaph to a Dog","align":"c","ls":1.0,"font":"PF","size":15.0,"color":"#51705A","spc":0.0},{"t":"verse","bind":"verse","x":0.38,"y":1.18,"w":3.24,"h":3.5,"anchor":"m","sample":"Near this spot are deposited the remains of one who possessed beauty without vanity, strength without insolence, courage without ferocity, and all the virtues of man without his vices.\nTo mark a friend’s remains these stones arise; I never knew but one, and here he lies.\nLord Byron, Epitaph to a Dog, 1808","align":"c","ls":1.3,"font":"LA","size":10.2,"color":"#33403A","spc":0.0,"prose":{"font":"LA","size":10.2,"color":"#33403A","ls":1.3,"after":6.12},"poem":{"font":"LAi","size":9.6,"color":"#33403A","ls":1.18,"stanza":5.28},"source":{"font":"LAi","size":8,"color":"#66776B","ls":1.0,"before":5.6}},{"t":"text","bind":"in_memory","x":0.38,"y":4.78,"w":3.24,"h":0.1562,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":9.0,"color":"#66776B","spc":0.0},{"t":"text","bind":"name","x":0.38,"y":4.9562,"w":3.24,"h":0.2456,"anchor":"m","sample":"Max","align":"c","ls":0.95,"font":"PF","size":13.0,"color":"#2F4034","spc":0.0},{"t":"text","bind":"dates","x":0.38,"y":5.2218,"w":3.24,"h":0.1892,"anchor":"m","sample":"October 30, 2011 – August 29, 2026","align":"c","ls":1.1,"font":"LA","size":8.6,"color":"#33403A","spc":0.2}],"bg":"cm-bg-pet-46-pet_meadow-back.jpg","px":[1200,1800]}],"pet_rose":[{"design":"pet_rose","side":"front","w":4.0,"h":6.0,"els":[{"t":"text","bind":"kicker","x":0.2,"y":0.36,"w":3.6,"h":0.62,"anchor":"m","sample":"Loved Beyond Words","align":"c","ls":1.0,"font":"GV","size":26.0,"color":"#A86F6F","spc":0.0},{"t":"photo","bind":"photo","x":0.85,"y":1.06,"w":2.3,"h":2.8111,"border":"#C4908E","bw":1.0},{"t":"text","bind":"name","x":0.35,"y":4.0111,"w":3.3,"h":0.62,"anchor":"m","sample":"Luna","align":"c","ls":0.92,"font":"PF","size":19.0,"color":"#3A383B","spc":0.0},{"t":"text","bind":"dates","x":0.35,"y":4.6911,"w":3.3,"h":0.21,"anchor":"m","sample":"May 19, 2009 – September 15, 2026","align":"c","ls":1.15,"font":"LA","size":9.5,"color":"#3E3B3F","spc":0.2}],"bg":"cm-bg-pet-46-pet_rose-front.jpg","px":[1200,1800]},{"design":"pet_rose","side":"back","w":4.0,"h":6.0,"els":[{"t":"text","bind":"verse_title","x":0.2,"y":0.76,"w":3.6,"h":0.36,"anchor":"m","sample":"Paw Prints on Our Hearts","align":"c","ls":1.0,"font":"PF","size":15.0,"color":"#A0696A","spc":0.0},{"t":"verse","bind":"verse","x":0.38,"y":1.18,"w":3.24,"h":3.5,"anchor":"m","sample":"Small paws that padded through our days,\na nose that found us when we cried,\na warm weight curled against our feet,\na steady friend who never lied.\nYou left your paw prints on our hearts;\nthey do not fade, they will not part.\nWherever love is kept and known,\nyou are still here, and still our own.","align":"c","ls":1.18,"font":"LAi","size":9.6,"color":"#3E3B3F","spc":0.0,"prose":{"font":"LA","size":10.2,"color":"#3E3B3F","ls":1.3,"after":6.12},"poem":{"font":"LAi","size":9.6,"color":"#3E3B3F","ls":1.18,"stanza":5.28},"source":{"font":"LAi","size":8,"color":"#7A6D6F","ls":1.0,"before":5.6}},{"t":"text","bind":"in_memory","x":0.38,"y":4.78,"w":3.24,"h":0.1562,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":9.0,"color":"#7A6D6F","spc":0.0},{"t":"text","bind":"name","x":0.38,"y":4.9562,"w":3.24,"h":0.2456,"anchor":"m","sample":"Luna","align":"c","ls":0.95,"font":"PF","size":13.0,"color":"#3A383B","spc":0.0},{"t":"text","bind":"dates","x":0.38,"y":5.2218,"w":3.24,"h":0.1892,"anchor":"m","sample":"May 19, 2009 – September 15, 2026","align":"c","ls":1.1,"font":"LA","size":8.6,"color":"#3E3B3F","spc":0.2}],"bg":"cm-bg-pet-46-pet_rose-back.jpg","px":[1200,1800]}],"pet_slate":[{"design":"pet_slate","side":"front","w":4.0,"h":6.0,"els":[{"t":"text","bind":"kicker","x":0.2,"y":0.36,"w":3.6,"h":0.62,"anchor":"m","sample":"In Loving Memory","align":"c","ls":1.0,"font":"GV","size":18.78,"color":"#4B5560","spc":0.0},{"t":"photo","bind":"photo","x":0.85,"y":1.06,"w":2.3,"h":2.8111,"border":"#66717F","bw":1.0},{"t":"text","bind":"name","x":0.35,"y":4.0111,"w":3.3,"h":0.62,"anchor":"m","sample":"Cooper","align":"c","ls":0.92,"font":"PF","size":19.0,"color":"#26282C","spc":0.0},{"t":"text","bind":"dates","x":0.35,"y":4.6911,"w":3.3,"h":0.21,"anchor":"m","sample":"March 3, 2013 – September 24, 2026","align":"c","ls":1.15,"font":"LA","size":9.5,"color":"#34373C","spc":0.2}],"bg":"cm-bg-pet-46-pet_slate-front.jpg","px":[1200,1800]},{"design":"pet_slate","side":"back","w":4.0,"h":6.0,"els":[{"t":"text","bind":"verse_title","x":0.2,"y":0.76,"w":3.6,"h":0.36,"anchor":"m","sample":"A Good Life","align":"c","ls":1.0,"font":"PF","size":15.0,"color":"#4B5560","spc":0.0},{"t":"verse","bind":"verse","x":0.38,"y":1.18,"w":3.24,"h":3.5,"anchor":"m","sample":"You were loved every day of your life, and you loved us back without condition. You were patient when we were busy, gentle when we were sad, and glad every single time we came home.\nThank you for the walks, the welcomes and the quiet evenings. Thank you for being a good boy. Rest now, old friend. You did everything right.","align":"c","ls":1.3,"font":"LA","size":10.2,"color":"#34373C","spc":0.0,"prose":{"font":"LA","size":10.2,"color":"#34373C","ls":1.3,"after":6.12},"poem":{"font":"LAi","size":9.6,"color":"#34373C","ls":1.18,"stanza":5.28},"source":{"font":"LAi","size":8,"color":"#6B7079","ls":1.0,"before":5.6}},{"t":"text","bind":"in_memory","x":0.38,"y":4.78,"w":3.24,"h":0.1562,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":9.0,"color":"#6B7079","spc":0.0},{"t":"text","bind":"name","x":0.38,"y":4.9562,"w":3.24,"h":0.2456,"anchor":"m","sample":"Cooper","align":"c","ls":0.95,"font":"PF","size":13.0,"color":"#26282C","spc":0.0},{"t":"text","bind":"dates","x":0.38,"y":5.2218,"w":3.24,"h":0.1892,"anchor":"m","sample":"March 3, 2013 – September 24, 2026","align":"c","ls":1.1,"font":"LA","size":8.6,"color":"#34373C","spc":0.2}],"bg":"cm-bg-pet-46-pet_slate-back.jpg","px":[1200,1800]}],"pet_lilac":[{"design":"pet_lilac","side":"front","w":4.0,"h":6.0,"els":[{"t":"text","bind":"kicker","x":0.2,"y":0.36,"w":3.6,"h":0.62,"anchor":"m","sample":"Always in Our Hearts","align":"c","ls":1.0,"font":"GV","size":24.56,"color":"#806BA2","spc":0.0},{"t":"photo","bind":"photo","x":0.85,"y":1.06,"w":2.3,"h":2.8111,"border":"#A08CC0","bw":1.0},{"t":"text","bind":"name","x":0.35,"y":4.0111,"w":3.3,"h