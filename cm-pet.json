 and all the virtues of man without his vices.\nTo mark a friend’s remains these stones arise; I never knew but one, and here he lies.\nLord Byron, Epitaph to a Dog, 1808","align":"c","ls":1.3,"font":"LA","size":7.0,"color":"#33403A","spc":0.0,"prose":{"font":"LA","size":7.0,"color":"#33403A","ls":1.3,"after":4.2},"poem":{"font":"LAi","size":6.75,"color":"#33403A","ls":1.18,"stanza":3.71},"source":{"font":"LAi","size":5.8,"color":"#66776B","ls":1.0,"before":4.06}},{"t":"text","bind":"in_memory","x":0.24,"y":3.4,"w":2.02,"h":0.1094,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":6.3,"color":"#66776B","spc":0.0},{"t":"text","bind":"name","x":0.24,"y":3.5294,"w":2.02,"h":0.1738,"anchor":"m","sample":"Max","align":"c","ls":0.95,"font":"PF","size":9.2,"color":"#2F4034","spc":0.0},{"t":"text","bind":"dates","x":0.24,"y":3.7232,"w":2.02,"h":0.1392,"anchor":"m","sample":"October 30, 2011 – August 29, 2026","align":"c","ls":1.1,"font":"LA","size":6.2,"color":"#33403A","spc":0.2}],"bg":"cm-bg-pet-25-pet_meadow-back.jpg","px":[750,1275]}],"pet_rose":[{"design":"pet_rose","side":"front","w":2.5,"h":4.25,"els":[{"t":"text","bind":"kicker","x":0.15,"y":0.24,"w":2.2,"h":0.44,"anchor":"m","sample":"Loved Beyond Words","align":"c","ls":1.0,"font":"GV","size":17.0,"color":"#A86F6F","spc":0.0},{"t":"photo","bind":"photo","x":0.52,"y":0.72,"w":1.46,"h":1.7844,"border":"#C4908E","bw":0.75},{"t":"text","bind":"name","x":0.22,"y":2.6044,"w":2.06,"h":0.44,"anchor":"m","sample":"Luna","align":"c","ls":0.92,"font":"PF","size":12.5,"color":"#3A383B","spc":0.0},{"t":"text","bind":"dates","x":0.22,"y":3.0844,"w":2.06,"h":0.15,"anchor":"m","sample":"May 19, 2009 – September 15, 2026","align":"c","ls":1.15,"font":"LA","size":6.8,"color":"#3E3B3F","spc":0.2}],"bg":"cm-bg-pet-25-pet_rose-front.jpg","px":[750,1275]},{"design":"pet_rose","side":"back","w":2.5,"h":4.25,"els":[{"t":"text","bind":"verse_title","x":0.15,"y":0.5,"w":2.2,"h":0.26,"anchor":"m","sample":"Paw Prints on Our Hearts","align":"c","ls":1.0,"font":"PF","size":10.5,"color":"#A0696A","spc":0.0},{"t":"verse","bind":"verse","x":0.24,"y":0.78,"w":2.02,"h":2.58,"anchor":"m","sample":"Small paws that padded through our days,\na nose that found us when we cried,\na warm weight curled against our feet,\na steady friend who never lied.\nYou left your paw prints on our hearts;\nthey do not fade, they will not part.\nWherever love is kept and known,\nyou are still here, and still our own.","align":"c","ls":1.18,"font":"LAi","size":6.75,"color":"#3E3B3F","spc":0.0,"prose":{"font":"LA","size":7.0,"color":"#3E3B3F","ls":1.3,"after":4.2},"poem":{"font":"LAi","size":6.75,"color":"#3E3B3F","ls":1.18,"stanza":3.71},"source":{"font":"LAi","size":5.8,"color":"#7A6D6F","ls":1.0,"before":4.06}},{"t":"text","bind":"in_memory","x":0.24,"y":3.4,"w":2.02,"h":0.1094,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":6.3,"color":"#7A6D6F","spc":0.0},{"t":"text","bind":"name","x":0.24,"y":3.5294,"w":2.02,"h":0.1738,"anchor":"m","sample":"Luna","align":"c","ls":0.95,"font":"PF","size":9.2,"color":"#3A383B","spc":0.0},{"t":"text","bind":"dates","x":0.24,"y":3.7232,"w":2.02,"h":0.1392,"anchor":"m","sample":"May 19, 2009 – September 15, 2026","align":"c","ls":1.1,"font":"LA","size":6.2,"color":"#3E3B3F","spc":0.2}],"bg":"cm-bg-pet-25-pet_rose-back.jpg","px":[750,1275]}],"pet_slate":[{"design":"pet_slate","side":"front","w":2.5,"h":4.25,"els":[{"t":"text","bind":"kicker","x":0.15,"y":0.24,"w":2.2,"h":0.44,"anchor":"m","sample":"In Loving Memory","align":"c","ls":1.0,"font":"GV","size":12.28,"color":"#4B5560","spc":0.0},{"t":"photo","bind":"photo","x":0.52,"y":0.72,"w":1.46,"h":1.7844,"border":"#66717F","bw":0.75},{"t":"text","bind":"name","x":0.22,"y":2.6044,"w":2.06,"h":0.44,"anchor":"m","sample":"Cooper","align":"c","ls":0.92,"font":"PF","size":12.5,"color":"#26282C","spc":0.0},{"t":"text","bind":"dates","x":0.22,"y":3.0844,"w":2.06,"h":0.15,"anchor":"m",