navy","side":"back","w":4.0,"h":6.0,"els":[{"t":"text","bind":"verse_title","x":0.2,"y":0.76,"w":3.6,"h":0.36,"anchor":"m","sample":"Du’a for the Departed","align":"c","ls":1.0,"font":"PF","size":15.0,"color":"#1E2A44","spc":0.0},{"t":"verse","bind":"verse","x":0.38,"y":1.18,"w":3.24,"h":3.5,"anchor":"m","sample":"Allahumma ighfir lahu warhamhu wa ‘afihi wa’fu ‘anhu, wa akrim nuzulahu wa wassi’ mudkhalahu, waghsilhu bil-ma’i wath-thalji wal-barad.\nO Allah, forgive him and have mercy on him; grant him well-being and pardon him. Honor his place of rest and make his entrance wide. Wash him with water, snow and hail, and cleanse him of sins as a white garment is cleansed of stain. Grant him a home better than his home, and admit him into Paradise.\nFrom the funeral prayer (Sahih Muslim), plain rendering","align":"c","ls":1.3,"font":"LA","size":10.2,"color":"#2C3650","spc":0.0,"prose":{"font":"LA","size":10.2,"color":"#2C3650","ls":1.3,"after":6.12},"poem":{"font":"LAi","size":9.6,"color":"#2C3650","ls":1.18,"stanza":5.28},"source":{"font":"LAi","size":8,"color":"#5F6882","ls":1.0,"before":5.6}},{"t":"text","bind":"in_memory","x":0.38,"y":4.78,"w":3.24,"h":0.1562,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":9.0,"color":"#5F6882","spc":0.0},{"t":"text","bind":"name","x":0.38,"y":4.9562,"w":3.24,"h":0.2456,"anchor":"m","sample":"Muhammad Yusuf Rahman","align":"c","ls":0.95,"font":"PF","size":13.0,"color":"#1E2A44","spc":0.0},{"t":"text","bind":"dates","x":0.38,"y":5.2218,"w":3.24,"h":0.1892,"anchor":"m","sample":"June 12, 1948 – September 10, 2026","align":"c","ls":1.1,"font":"LA","size":8.6,"color":"#2C3650","spc":0.2}],"bg":"cm-bg-muslim-46-sun_navy-back.jpg","px":[1200,1800]}],"sun_teal":[{"design":"sun_teal","side":"front","w":4.0,"h":6.0,"els":[{"t":"text","bind":"kicker","x":0.2,"y":0.36,"w":3.6,"h":0.62,"anchor":"m","sample":"Forever in Our Du’a","align":"c","ls":1.0,"font":"GV","size":23.11,"color":"#1E6A73","spc":0.0},{"t":