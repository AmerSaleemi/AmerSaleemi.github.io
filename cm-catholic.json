bind":"verse_title","x":0.15,"y":0.5,"w":2.2,"h":0.26,"anchor":"m","sample":"The Memorare","align":"c","ls":1.0,"font":"PF","size":10.5,"color":"#A0696A","spc":0.0},{"t":"verse","bind":"verse","x":0.24,"y":0.78,"w":2.02,"h":2.58,"anchor":"m","sample":"Remember, O most gracious Virgin Mary, that never was it known that anyone who fled to thy protection, implored thy help, or sought thy intercession was left unaided.\nInspired by this confidence, I fly unto thee, O Virgin of virgins, my Mother; to thee do I come, before thee I stand, sinful and sorrowful. O Mother of the Word Incarnate, despise not my petitions, but in thy mercy hear and answer me. Amen.\nTraditional prayer","align":"c","ls":1.3,"font":"LA","size":7.0,"color":"#3E3B3F","spc":0.0,"prose":{"font":"LA","size":7.0,"color":"#3E3B3F","ls":1.3,"after":4.2},"poem":{"font":"LAi","size":6.75,"color":"#3E3B3F","ls":1.18,"stanza":3.71},"source":{"font":"LAi","size":5.8,"color":"#7A6D6F","ls":1.0,"before":4.06}},{"t":"text","bind":"in_memory","x":0.24,"y":3.4,"w":2.02,"h":0.1094,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":6.3,"color":"#7A6D6F","spc":0.0},{"t":"text","bind":"name","x":0.24,"y":3.5294,"w":2.02,"h":0.1738,"anchor":"m","sample":"Eleanor Grace Whitfield","align":"c","ls":0.95,"font":"PF","size":9.2,"color":"#3A383B","spc":0.0},{"t":"text","bind":"dates","x":0.24,"y":3.7232,"w":2.02,"h":0.1392,"anchor":"m","sample":"March 4, 1941 – September 12, 2026","align":"c","ls":1.1,"font":"LA","size":6.2,"color":"#3E3B3F","spc":0.2}],"bg":"cm-bg-catholic-25-cath_rose-back.jpg","px":[750,1275]}],"cath_olive":[{"design":"cath_olive","side":"front","w":2.5,"h":4.25,"els":[{"t":"text","bind":"kicker","x":0.15,"y":0.24,"w":2.2,"h":0.44,"anchor":"m","sample":"In God’s Care","align":"c","ls":1.0,"font":"GV","size":17.94,"color":"#5F7249","spc":0.0},{"t":"photo","bind":"photo","x":0.52,"y":0.72,"w":1.46,"h":1.7844,"border":"#8A9A6A","bw":0.75},{"t":"text","bind":"name","x":0.22,"y":2.6044,"w":2.06,"h":0.44,"anchor":"m","sample":"Robert James Carter","align":"c","ls":0.92,"font":"PF","size":12.5,"color":"#2F3A2C","spc":0.0},{"t":"text","bind":"dates","x":0.22,"y":3.0844,"w":2.06,"h":0.15,"anchor":"m","sample":"June 12, 1948 – September 10, 2026","align":"c","ls":1.15,"font":"LA","size":6.8,"color":"#343E32","spc":0.2}],"bg":"cm-bg-catholic-25-cath_olive-front.jpg","px":[750,1275]},{"design":"cath_olive","side":"back","w":2.5,"h":4.25,"els":[{"t":"text","bind":"verse_title","x":0.15,"y":0.5,"w":2.2,"h":0.26,"anchor":"m","sample":"The Twenty-Third Psalm","align":"c","ls":1.0,"font":"PF","size":10.5,"color":"#5A6B45","spc":0.0},{"t":"verse","bind":"verse","x":0.24,"y":0.78,"w":2.02,"h":2.58,"anchor":"m","sample":"The Lord ruleth me: and I shall want nothing. He hath set me in a place of pasture. He hath brought me up on the water of refreshment: he hath converted my soul. He hath led me on the paths of justice, for his own name’s sake. For though I should walk in the midst of the shadow of death, I will fear no evils, for thou art with me. Thy rod and thy staff, they have comforted me. Thou hast prepared a table before me against them that afflict me. Thou hast anointed my head with oil; and my chalice which inebriateth me, how goodly is it! And thy mercy will follow me all the days of my life. And that I may dwell in the house of the Lord unto length of days.\nPsalm 22 (23), Douay-Rheims","align":"c","ls":1.3,"font":"LA","size":7.0,"color":"#343E32","spc":0.0,"prose":{"font":"LA","size":7.0,"color":"#343E32","ls":1.3,"after":4.2},"poem":{"font":"LAi","size":6.75,"color":"#343E32","ls":1.18,"stanza":3.71},"source":{"font":"LAi","size":5.8,"color":"#68725E","ls":1.0,"before":4.06}},{"t":"text","bind":"in_memory","x":0.24,"y":3.4,"w":2.02,"h":0.1094,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":6.3,"color":"#68725E","spc":0.0},{"t":"text","bind":"name","x":0.24,"y":3.5294,"w":2.02,"h":0.1738,"anchor":"m","sam