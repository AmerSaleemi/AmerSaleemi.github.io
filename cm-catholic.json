c":0.2}],"bg":"cm-bg-catholic-46-cath_marian-back.jpg","px":[1200,1800]}],"cath_rose":[{"design":"cath_rose","side":"front","w":4.0,"h":6.0,"els":[{"t":"text","bind":"kicker","x":0.2,"y":0.36,"w":3.6,"h":0.62,"anchor":"m","sample":"Forever in Our Hearts","align":"c","ls":1.0,"font":"GV","size":23.83,"color":"#A86F6F","spc":0.0},{"t":"photo","bind":"photo","x":0.85,"y":1.06,"w":2.3,"h":2.8111,"border":"#C4908E","bw":1.0},{"t":"text","bind":"name","x":0.35,"y":4.0111,"w":3.3,"h":0.62,"anchor":"m","sample":"Eleanor Grace Whitfield","align":"c","ls":0.92,"font":"PF","size":19.0,"color":"#3A383B","spc":0.0},{"t":"text","bind":"dates","x":0.35,"y":4.6911,"w":3.3,"h":0.21,"anchor":"m","sample":"March 4, 1941 – September 12, 2026","align":"c","ls":1.15,"font":"LA","size":9.5,"color":"#3E3B3F","spc":0.2}],"bg":"cm-bg-catholic-46-cath_rose-front.jpg","px":[1200,1800]},{"design":"cath_rose","side":"back","w":4.0,"h":6.0,"els":[{"t":"text","bind":"verse_title","x":0.2,"y":0.76,"w":3.6,"h":0.36,"anchor":"m","sample":"The Memorare","align":"c","ls":1.0,"font":"PF","size":15.0,"color":"#A0696A","spc":0.0},{"t":"verse","bind":"verse","x":0.38,"y":1.18,"w":3.24,"h":3.5,"anchor":"m","sample":"Remember, O most gracious Virgin Mary, that never was it known that anyone who fled to thy protection, implored thy help, or sought thy intercession was left unaided.\nInspired by this confidence, I fly unto thee, O Virgin of virgins, my Mother; to thee do I come, before thee I stand, sinful and sorrowful. O Mother of the Word Incarnate, despise not my petitions, but in thy mercy hear and answer me. Amen.\nTraditional prayer","align":"c","ls":1.3,"font":"LA","size":10.2,"color":"#3E3B3F","spc":0.0,"prose":{"font":"LA","size":10.2,"color":"#3E3B3F","ls":1.3,"after":6.12},"poem":{"font":"LAi","size":9.6,"color":"#3E3B3F","ls":1.18,"stanza":5.28},"source":{"font":"LAi","size":8,"color":"#7A6D6F","ls":1.0,"before":5.6}},{"t":"text","bind":"in_memory","x":0.38,"y":4.78,"w":3.24,"h":0.1562,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":9.0,"color":"#7A6D6F","spc":0.0},{"t":"text","bind":"name","x":0.38,"y":4.9562,"w":3.24,"h":0.2456,"anchor":"m","sample":"Eleanor Grace Whitfield","align":"c","ls":0.95,"font":"PF","size":13.0,"color":"#3A383B","spc":0.0},{"t":"text","bind":"dates","x":0.38,"y":5.2218,"w":3.24,"h":0.1892,"anchor":"m","sample":"March 4, 1941 – September 12, 2026","align":"c","ls":1.1,"font":"LA","size":8.6,"color":"#3E3B3F","spc":0.2}],"bg":"cm-bg-catholic-46-cath_rose-back.jpg","px":[1200,1800]}],"cath_olive":[{"design":"cath_olive","side":"front","w":4.0,"h":6.0,"els":[{"t":"text","bind":"kicker","x":0.2,"y":0.36,"w":3.6,"h":0.62,"anchor":"m","sample":"In God’s Care","align":"c","ls":1.0,"font":"GV","size":27.44,"color":"#5F7249","spc":0.0},{"t":"photo","bind":"photo","x":0.85,"y":1.06,"w":2.3,"h":2.8111,"border":"#8A9A6A","bw":1.0},{"t":"text","bind":"name","x":0.35,"y":4.0111,"w":3.3,"h":0.62,"anchor":"m","sample":"Robert James Carter","align":"c","ls":0.92,"font":"PF","size":19.0,"color":"#2F3A2C","spc":0.0},{"t":"text","bind":"dates","x":0.35,"y":4.6911,"w":3.3,"h":0.21,"anchor":"m","sample":"June 12, 1948 – September 10, 2026","align":"c","ls":1.15,"font":"LA","size":9.5,"color":"#343E32","spc":0.2}],"bg":"cm-bg-catholic-46-cath_olive-front.jpg","px":[1200,1800]},{"design":"cath_olive","side":"back","w":4.0,"h":6.0,"els":[{"t":"text","bind":"verse_title","x":0.2,"y":0.76,"w":3.6,"h":0.36,"anchor":"m","sample":"The Twenty-Third Psalm","align":"c","ls":1.0,"font":"PF","size":15.0,"color":"#5A6B45","spc":0.0},{"t":"verse","bind":"verse","x":0.38,"y":1.18,"w":3.24,"h":3.5,"anchor":"m","sample":"The Lord ruleth me: and I shall want nothing. He hath set me in a place of pasture. He hath brought me up on the water of refreshment: he hath converted my soul. He hath led me on the paths of justice, for his own name’s sake. For though I should walk in the midst of the shadow of death, I will fear no evils, for thou art with me. Thy rod and thy staff, they have comforted me. Thou hast prepared a table before me against them that afflict me. Thou hast anointed my head with oil; and my chalice which inebriateth me, how goodly is it! And thy mercy will follow me all the days of my life. And that I may dwell in the house of the Lord unto length of days.\nPsalm 22 (23), Douay-Rheims","align":"c","ls":1.3,"font":"LA","size":10.2,"color":"#343E32","spc":0.0,"prose":{"font":"LA","size":10.2,"color":"#343E32","ls":1.3,"after":6.12},"poem":{"font":"LAi","size":9.6,"color":"#343E32","ls":1.18,"stanza":5.28},"source":{"font":"LAi","size":8,"color":"#68725E","ls":1.0,"before":5.6}},{"t":"text","bind":"in_memory","x":0.38,"y":4.78,"w":3.24,"h":0.1562,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":9.0,"color":"#68725E","spc":0.0},{"t":"text","bind":"name","x":0.38,"y":4.9562,"w":3.24,"h":0.2456,"anchor":"m","sample":"Robert James Carter","align":"c","ls":0.95,"font":"PF","size":13.0,"color":"#2F3A2C","spc":0.0},{"t":"text","bind":"dates","x":0.38,"y":5.2218,"w":3.24,"h":0.1892,"anchor":"m","sample":"June 12, 1948 – September 10, 2026","align":"c","ls":1.1,"font":"LA","size":8.6,"color":"#343E32","spc":0.2}],"bg":"cm-bg-catholic-46-cath_olive-back.jpg","px":[1200,1800]}],"cath_burgundy":[{"design":"cath_burgundy","side":"front","w":4.0,"h":6.0,"els":[{"t":"text","bind":"kicker","x":0.2,"y":0.36,"w":3.6,"h":0.62,"anchor":"m","sample":"Until We Meet Again","align":"c","ls":1.0,"font":"GV","size":24.56,"color":"#7A2E3A","spc":0.0},{"t":"photo","bind":"photo","x":0.85,"y":1.06,"w":2.3,"h":2.8111,"border":"#B8955A","bw":1.0},{"t":"text","bind":"name","x":0.35,"y":4.0111,"w":3.3,"h":0.62,"anchor":"m","sample":"Eleanor Grace Whitfield","align":"c","ls":0.92,"font":"PF","size":19.0,"color":"#4A1D24","spc":0.0},{"t":"text","bind":"dates","x":0.35,"y":4.6911,"w":3.3,"h":0.21,"anchor":"m","sample":"March 4, 1941 – September 12, 2026","align":"c","ls":1.15,"font":"LA