emption. And he shall redeem Israel from all his iniquities.\nEternal rest grant unto her, O Lord, and let perpetual light shine upon her. May she rest in peace. Amen.\nPsalm 129 (130), Douay-Rheims","align":"c","ls":1.3,"font":"LA","size":7.0,"color":"#3A2C2E","spc":0.0,"prose":{"font":"LA","size":7.0,"color":"#3A2C2E","ls":1.3,"after":4.2},"poem":{"font":"LAi","size":6.75,"color":"#3A2C2E","ls":1.18,"stanza":3.71},"source":{"font":"LAi","size":5.8,"color":"#6E5F60","ls":1.0,"before":4.06}},{"t":"text","bind":"in_memory","x":0.24,"y":3.4,"w":2.02,"h":0.1094,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":6.3,"color":"#6E5F60","spc":0.0},{"t":"text","bind":"name","x":0.24,"y":3.5294,"w":2.02,"h":0.1738,"anchor":"m","sample":"Eleanor Grace Whitfield","align":"c","ls":0.95,"font":"PF","size":9.2,"color":"#4A1D24","spc":0.0},{"t":"text","bind":"dates","x":0.24,"y":3.7232,"w":2.02,"h":0.1392,"anchor":"m","sample":"March 4, 1941 – September 12, 2026","align":"c","ls":1.1,"font":"LA","size":6.2,"color":"#3A2C2E","spc":0.2}],"bg":"cm-bg-catholic-25-cath_burgundy-back.jpg","px":[750,1275]}]},"46":{"cath_ivory":[{"design":"cath_ivory","side":"front","w":4.0,"h":6.0,"els":[{"t":"text","bind":"kicker","x":0.2,"y":0.36,"w":3.6,"h":0.62,"anchor":"m","sample":"In Loving Memory","align":"c","ls":1.0,"font":"GV","size":26.0,"color":"#8A7340","spc":0.0},{"t":"photo","bind":"photo","x":0.85,"y":1.06,"w":2.3,"h":2.8111,"border":"#B8955A","bw":1.0},{"t":"text","bind":"name","x":0.35,"y":4.0111,"w":3.3,"h":0.62,"anchor":"m","sample":"Eleanor Grace Whitfield","align":"c","ls":0.92,"font":"PF","size":19.0,"color":"#2A2926","spc":0.0},{"t":"text","bind":"dates","x":0.35,"y":4.6911,"w":3.3,"h":0.21,"anchor":"m","sample":"March 4, 1941 – September 12, 2026","align":"c","ls":1.15,"font":"LA","size":9.5,"color":"#3A3733","spc":0.2}],"bg":"cm-bg-catholic-46-cath_ivory-front.jpg","px":[1200,1800]},{"design":"cath_ivory","side":"back","w":4.0,"h":6.0,"els":[{"