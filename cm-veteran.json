ath, I will fear no evil: for thou art with me; thy rod and thy staff they comfort me. Thou preparest a table before me in the presence of mine enemies: thou anointest my head with oil; my cup runneth over. Surely goodness and mercy shall follow me all the days of my life: and I will dwell in the house of the Lord for ever.\nPsalm 23, King James Version","align":"c","ls":1.3,"font":"LA","size":7.0,"color":"#343E32","spc":0.0,"prose":{"font":"LA","size":7.0,"color":"#343E32","ls":1.3,"after":4.2},"poem":{"font":"LAi","size":6.75,"color":"#343E32","ls":1.18,"stanza":3.71},"source":{"font":"LAi","size":5.8,"color":"#68725E","ls":1.0,"before":4.06}},{"t":"text","bind":"in_memory","x":0.24,"y":3.4,"w":2.02,"h":0.1094,"anchor":"m","sample":"In honored memory of","align":"c","ls":1.0,"font":"LAi","size":6.3,"color":"#68725E","spc":0.0},{"t":"text","bind":"name","x":0.24,"y":3.5294,"w":2.02,"h":0.1738,"anchor":"m","sample":"Lt. Eleanor Grace Whitfield","align":"c","ls":0.95,"font":"PF","size":9.2,"color":"#2F3A2C","spc":0.0},{"t":"text","bind":"dates","x":0.24,"y":3.7232,"w":2.02,"h":0.1392,"anchor":"m","sample":"March 4, 1941 – September 12, 2026","align":"c","ls":1.1,"font":"LA","size":6.2,"color":"#343E32","spc":0.2}],"bg":"cm-bg-veteran-25-vet_olive-back.jpg","px":[750,1275]}]},"46":{"vet_navy":[{"design":"vet_navy","side":"front","w":4.0,"h":6.0,"els":[{"t":"text","bind":"kicker","x":0.2,"y":0.36,"w":3.6,"h":0.62,"anchor":"m","sample":"In Honored Memory","align":"c","ls":1.0,"font":"GV","size":23.11,"color":"#1E2A44","spc":0.0},{"t":"photo","bind":"photo","x":0.85,"y":1.06,"w":2.3,"h":2.8111,"border":"#B39457","bw":1.0},{"t":"text","bind":"name","x":0.35,"y":4.0111,"w":3.3,"h":0.62,"anchor":"m","sample":"Sgt. Robert James Carter","align":"c","ls":0.92,"font":"PF","size":19.0,"color":"#1E2A44","spc":0.0},{"t":"text","bind":"dates","x":0.35,"y":4.6911,"w":3.3,"h":0.21,"anchor":"m","sample":"June 12, 1948 – September 10, 2026","align":"c","ls":1.15,"font":"LA","size":9.5,"color":"#2C3650","spc":0.2}],"bg":"cm-bg-veteran-46-vet_navy-front.jpg","px":[1200,1800]},{"design":"vet_navy","side":"back","w":4.0,"h":6.0,"els":[{"t":"text","bind":"verse_title","x":0.2,"y":0.76,"w":3.6,"h":0.36,"anchor":"m","sample":"Taps","align":"c","ls":1.0,"font":"PF","size":15.0,"color":"#1E2A44","spc":0.0},{"t":"verse","bind":"verse","x":0.38,"y":1.18,"w":3.24,"h":3.5,"anchor":"m","sample":"Day is done, gone the sun,\nfrom the lake, from the hills, from the sky;\nall is well, safely rest,\nGod is nigh.\nFading light dims the sight,\nand a star gems the sky, gleaming bright.\nFrom afar drawing nigh,\nfalls the night.\nThanks and praise for our days\n’neath the sun, ’neath the stars, ’neath the sky;\nas we go, this we know:\nGod is nigh.\n“Taps”, traditional words to the 1862 call","align":"c","ls":1.18,"font":"LAi","size":9.6,"color":"#2C3650","spc":0.0,"prose":{"font":"LA","size":10.2,"color":"#2C3650","ls":1.3,"after":6.12},"poem":{"font":"LAi","size":9.6,"color":"#2C3650","ls":1.18,"stanza":5.28},"source":{"font":"LAi","size":8,"color":"#5F6882","ls":1.0,"before":5.6}},{"t":"text","bind":"in_memory","x":0.38,"y":4.78,"w":3.24,"h":0.1562,"anchor":"m","sample":"In honored memory of","align":"c","ls":1.0,"font":"LAi","size":9.0,"color":"#5F6882","spc":0.0},{"t":"text","bind":"name","x":0.38,"y":4.9562,"w":3.24,"h":0.2456,"anchor":"m","sample":"Sgt. Robert James Carter","align":"c","ls":0.95,"font":"PF","size":13.0,"color":"#1E2A44","spc":0.0},{"t":"text","bind":"dates","x":0.38,"y":5.2218,"w":3.24,"h":0.1892,"anchor":"m","sample":"June 12, 1948 – September 10, 2026","align":"c","ls":1.1,"font":"LA","size":8.6,"color":"#2C3650","spc":0.2}],"bg":"cm-bg-veteran-46-vet_navy-back.jpg","px":[1200,1800]}],"vet_gold":[{"design":"vet_gold","side":"front","w":4.0,"h":6.0,"els":[{"t":"text","bind":"kicker","x":0.2,"y":0.36,"w":3.6,"h":0.62,"anchor":"m","sample":"Served With Honor","align":"c","ls":1.0,"font":"GV","size":23.11,"color":"#8A7340","spc":0.0},{"t":"photo"