e his appearing.\nGreater love hath no man than this, that a man lay down his life for his friends.\n2 Timothy 4:7-8 · John 15:13, King James Version","align":"c","ls":1.3,"font":"LA","size":7.0,"color":"#3A3733","spc":0.0,"prose":{"font":"LA","size":7.0,"color":"#3A3733","ls":1.3,"after":4.2},"poem":{"font":"LAi","size":6.75,"color":"#3A3733","ls":1.18,"stanza":3.71},"source":{"font":"LAi","size":5.8,"color":"#6E675C","ls":1.0,"before":4.06}},{"t":"text","bind":"in_memory","x":0.24,"y":3.4,"w":2.02,"h":0.1094,"anchor":"m","sample":"In honored memory of","align":"c","ls":1.0,"font":"LAi","size":6.3,"color":"#6E675C","spc":0.0},{"t":"text","bind":"name","x":0.24,"y":3.5294,"w":2.02,"h":0.1738,"anchor":"m","sample":"Sgt. Robert James Carter","align":"c","ls":0.95,"font":"PF","size":9.2,"color":"#2A2926","spc":0.0},{"t":"text","bind":"dates","x":0.24,"y":3.7232,"w":2.02,"h":0.1392,"anchor":"m","sample":"June 12, 1948 – September 10, 2026","align":"c","ls":1.1,"font":"LA","size":6.2,"color":"#3A3733","spc":0.2}],"bg":"cm-bg-veteran-25-vet_gold-back.jpg","px":[750,1275]}],"vet_charcoal":[{"design":"vet_charcoal","side":"front","w":2.5,"h":4.25,"els":[{"t":"text","bind":"kicker","x":0.15,"y":0.24,"w":2.2,"h":0.44,"anchor":"m","sample":"Home at Last","align":"c","ls":1.0,"font":"GV","size":17.0,"color":"#4A4A4A","spc":0.0},{"t":"photo","bind":"photo","x":0.52,"y":0.72,"w":1.46,"h":1.7844,"border":"#8C8C8C","bw":0.75},{"t":"text","bind":"name","x":0.22,"y":2.6044,"w":2.06,"h":0.44,"anchor":"m","sample":"Sgt. Robert James Carter","align":"c","ls":0.92,"font":"PF","size":12.5,"color":"#2A2A2A","spc":0.0},{"t":"text","bind":"dates","x":0.22,"y":3.0844,"w":2.06,"h":0.15,"anchor":"m","sample":"June 12, 1948 – September 10, 2026","align":"c","ls":1.15,"font":"LA","size":6.8,"color":"#3A3A3A","spc":0.2}],"bg":"cm-bg-veteran-25-vet_charcoal-front.jpg","px":[750,1275]},{"design":"vet_charcoal","side":"back","w":2.5,"h":4.25,"els":[{"t":"text","bind":"verse_title","x":0.15,"y":0.5,"w":2.2,"h":0.26,"anchor":"m","sample":"The Soldier’s Psalm","align":"c","ls":1.0,"font":"PF","size":10.5,"color":"#4A4A4A","spc":0.0},{"t":"verse","bind":"verse","x":0.24,"y":0.78,"w":2.02,"h":2.58,"anchor":"m","sample":"He that dwelleth in the secret place of the most High shall abide under the shadow of the Almighty. I will say of the Lord, He is my refuge and my fortress: my God; in him will I trust.\nHe shall cover thee with his feathers, and under his wings shalt thou trust: his truth shall be thy shield and buckler. Thou shalt not be afraid for the terror by night; nor for the arrow that flieth by day. For he shall give his angels charge over thee, to keep thee in all thy ways.\nPsalm 91:1-2, 4-5, 11, King James Version","align":"c","ls":1.3,"font":"LA","size":7.0,"color":"#3A3A3A","spc":0.0,"prose":{"font":"LA","size":7.0,"color":"#3A3A3A","ls":1.3,"after":4.2},"poem":{"font":"LAi","size":6.75,"color":"#3A3A3A","ls":1.18,"stanza":3.71},"source":{"font":"LAi","size":5.8,"color":"#707070","ls":1.0,"before":4.06}},{"t":"text","bind":"in_memory","x":0.24,"y":3.4,"w":2.02,"h":0.1094,"anchor":"m","sample":"In honored memory of","align":"c","ls":1.0,"font":"LAi","size":6.3,"color":"#707070","spc":0.0},{"t":"text","bind":"name","x":0.24,"y":3.5294,"w":2.02,"h":0.1738,"anchor":"m","sample":"Sgt. Robert James Carter","align":"c","ls":0.95,"font":"PF","size":9.2,"color":"#2A2A2A","spc":0.0},{"t":"text","bind":"dates","x":0.24,"y":3.7232,"w":2.02,"h":0.1392,"anchor":"m","sample":"June 12, 1948 – September 10, 2026","align":"c","ls":1.1,"font":"LA","size":6.2,"color":"#3A3A3A","spc":0.2}],"bg":"cm-bg-veteran-25-vet_charcoal-back.jpg","px":[750,1275]}],"vet_patriot":[{"design":"vet_patriot","side":"front","w":2.5,"h":4.25,"els":[{"t":"text","bind":"kicker","x":0.15,"y":0.24,"w":2.2,"h":0.44,"anchor":"m","sample":"Forever Remembered","align":"c","ls":1.0,"font":"GV","size":14.17,"color":"#8E2A2A","spc":0.0},{"t":"photo","bind":"photo","x":0.52,"y":0.72,"w":1.46,"h":1.7844,"border":"#1E2A44","bw":0.75},{"t":"text","bind":"name","x":0.22,"y":2.6044,"w":2.06,"h":0.44,"anchor":"m","sample":"Lt. Eleanor Grace Whitfield","align":"c","ls":0.92,"font":"PF","size":12.5,"color":"#1E2A44","spc":0.0},{"t":"text","bind":"dates","x":0.22,"y":3.0844,"w":2.06,"h":0.15,"anchor":"m","sample":"March 4, 1941 – September 12, 2026","align":"c","ls":1.15,"font":"LA","size":6.8,"color":"#2C3650","spc":0.2}],"bg":"cm-bg-veteran-25-vet_patriot-front.jpg","px":[750,1275]},{"design":"vet_patriot","side":"back","w":2.5,"h":4.25,"els":[{"t":"text","bind":"verse_title","x":0.15,"y":0.5,"w":2.2,"h":0.26,"anchor":"m","sample":"Last Salute","align":"c","ls":1.0,"font":"PF","size":10.5,"color":"#8E2A2A","spc":0.0},{"t":"verse","bind":"verse","x":0.24,"y":0.78,"w":2.02,"h":2.58,"anchor":"m","sample":"She answered when the country called\nand wore the uniform with pride;\nshe stood the watch and held the line\nwith brothers, sisters at her side.\nThe flag is folded, Taps is played,\nthe last salute is slowly made;\nthe watch is over. Rest, and know\nthat what you gave will never fade.\nWritten for this card","align":"c","ls":1.18,"font":"LAi","size":6.75,"color":"#2C3650","spc":0.0,"prose":{"font":"LA","size":7.0,"color":"#2C3650","ls":1.3,"after":4.2},"poem":{"font":"LAi","size":6.75,"color":"#2C3650","ls":1.18,"stanza":3.71},"source":{"font":"LAi","size":5.8,"color":"#5F6882","ls":1.0,"before":4.06}},{"t":"text","bind":"in_memory","x":0.24,"y":3.4,"w":2.02,"h":0.1094,"anchor":"m","sample":"In honored memory of","align":"c","ls":1.0,"font":"LAi","size":6.3,"color":"#5F6882","spc":0.0},{"t":"text","bind":"name","x":0.24,"y":3.5294,"w":2.02,"h":0.1738,"anchor":"m","sample":"Lt. Eleanor Grace Whitfield","align":"c","ls":0.95,"font":"PF","size":9.2,"color":"#1E2A44","spc":0.0},{"t":"text","bind":"dates","x":0.24,"y":3.7232,"w":2.02,"h":0.1392,"anchor":"m","sample":"March 4, 1941 – September 12, 2026","align":"c","ls":1.1,"font":"LA","size":6.2,"color":"#2C3650","spc":0.2}],"bg":"cm-bg-veteran-25-vet_patriot-back.jpg","px":[750,1275]}],"vet_sky":[{"design":"vet_sky","side":"front","w":2.5,"h":4.25,"els":[{"t":"text","bind":"kicker","x":0.15,"y":0.24,"w":2.2,"h":0.44,"anchor":"m","sample":"Fair Winds and Following Seas","align":"c","ls":1.0,"font":"GV","size":10.39,"color":"#2E5A8E","spc":0.0},{"t":"photo","bind":"photo","x":0.52,"y":0.72,"w":1.46,"h":1.7844,"border":"#5E86B8","bw":0.75},{"t":"text","bind":"name","x":0.22,"y":2.6044,"w":2.06,"h":0.44,"anchor":"m","sample":"Sgt. Robert James Carter","align":"c","ls":0.92,"font":"PF","size":12.5,"color":"#1F3450","spc":0.0},{"t":"text","bind":"dates","x":0.22,"y":3.0844,"w":2.06,"h":0.15,"anchor":"m","sample":"June 12, 1948 – September 10, 2026","align":"c","ls":1.15,"font":"LA","size":6.8,"color":"#2B3A4F","spc":0.2}],"bg":"cm-bg-veteran-25-vet_sky-front.jpg","px":[750,1275]},{"design":"vet_sky","side":"back","w":2.5,"h":4.25,"els":[{"t":"text","bind":"verse_title","x":0.15,"y":0.5,"w":2.2,"h":0.26,"anchor":"m","sample":"Eternal Father, Strong to Save","align":"c","ls":1.0,"font":"PF","size":10.5,"color":"#2E5A8E","spc":0.0},{"t":"verse","bind":"verse","x":0.24,"y":0.78,"w":2.02,"h":2.58,"anchor":"m","sample":"Eternal Father, strong to save,\nwhose arm hath bound the restless wave,\nwho bidd’st the mighty ocean deep\nits own appointed limits keep;\nO hear us when we cry to Thee\nfor those in peril on the sea.\nO Trinity of love and power,\nour brethren shield in danger’s hour;\nfrom rock and tempest, fire and foe,\nprotect them wheresoe’er they go;\nthus evermore shall rise to Thee\nglad hymns of praise from land and sea.\nWilliam Whiting, 1860 (the Navy Hymn)","align":"c","ls":1.18,"font":"LAi","size":6.75,"color":"#2B3A4F","spc":0.0,"prose":{"font":"LA","size":7.0,"color":"#2B3A4F","ls":1.3,"after":4.2},"poem":{"font":"LAi","size":6.75,"color":"#2B3A4F","ls":1.18,"stanza":3.71},"source":{"font":"LAi","size":5.8,"color":"#5D6D80","ls":1.0,"before":4.06}},{"t":"text","bind":"in_memory","x