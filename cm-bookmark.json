,"sample":"The Lord is my shepherd; I shall not want. He maketh me to lie down in green pastures: he leadeth me beside the still waters. He restoreth my soul: he leadeth me in the paths of righteousness for his name’s sake. Yea, though I walk through the valley of the shadow of death, I will fear no evil: for thou art with me; thy rod and thy staff they comfort me. Thou preparest a table before me in the presence of mine enemies: thou anointest my head with oil; my cup runneth over. Surely goodness and mercy shall follow me all the days of my life: and I will dwell in the house of the Lord for ever.\nPsalm 23, King James Version","align":"c","ls":1.3,"font":"LA","size":6.8,"color":"#2C3650","spc":0.0,"prose":{"font":"LA","size":6.8,"color":"#2C3650","ls":1.3,"after":4.08},"poem":{"font":"LAi","size":6.7,"color":"#2C3650","ls":1.18,"stanza":3.69},"source":{"font":"LAi","size":5.6,"color":"#5F6882","ls":1.0,"before":3.92}},{"t":"text","bind":"in_memory","x":0.2,"y":4.5,"w":1.6,"h":0.1094,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":6.3,"color":"#5F6882","spc":0.0,"paras":[{"align":"c","ls":1.0,"before":0.0,"after":0.0,"font":"LAi","size":6.3,"color":"#5F6882","spc":0.0,"text":"In loving memory of"}]},{"t":"text","bind":"name","x":0.2,"y":4.6294,"w":1.6,"h":0.3551,"anchor":"m","sample":"Eleanor Grace Whitfield","align":"c","ls":0.95,"font":"PF","size":9.4,"color":"#1E2A44","spc":0.0,"paras":[{"align":"c","ls":0.95,"before":0.0,"after":0.0,"font":"PF","size":9.4,"color":"#1E2A44","spc":0.0,"text":"Eleanor Grace Whitfield"}],"wrap":true},{"t":"text","bind":"dates","x":0.2,"y":5.0045,"w":1.6,"h":0.26,"anchor":"m","sample":"March 4, 1941 –\nSeptember 12, 2026","align":"c","ls":1.1,"font":"LA","size":6.0,"color":"#2C3650","spc":0.2,"paras":[{"align":"c","ls":1.1,"before":0.0,"after":0.0,"font":"LA","size":6.0,"color":"#2C3650","spc":0.2,"text":"March 4, 1941 –"},{"align":"c","ls":1.1,"before":0.0,"after":0.0,"font":"LA","size":6.0,"co