:0.0,"paras":[{"align":"c","ls":1.0,"before":0.0,"after":0.0,"font":"PF","size":10.5,"color":"#51705A","spc":0.0,"text":"Crossing the Bar"}]},{"t":"verse","bind":"verse","x":0.2,"y":1.1,"w":1.6,"h":3.25,"anchor":"m","sample":"Sunset and evening star,\nAnd one clear call for me!\nAnd may there be no moaning of the bar,\nWhen I put out to sea,\nBut such a tide as moving seems asleep,\nToo full for sound and foam,\nWhen that which drew from out the boundless deep\nTurns again home.\nTwilight and evening bell,\nAnd after that the dark!\nAnd may there be no sadness of farewell,\nWhen I embark;\nFor tho’ from out our bourne of Time and Place\nThe flood may bear me far,\nI hope to see my Pilot face to face\nWhen I have crost the bar.\nAlfred, Lord Tennyson","align":"c","ls":1.18,"font":"LAi","size":6.7,"color":"#33403A","spc":0.0,"prose":{"font":"LA","size":6.8,"color":"#33403A","ls":1.3,"after":4.08},"poem":{"font":"LAi","size":6.7,"color":"#33403A","ls":1.18,"stanza":3.69},"source":{"font":"LAi","size":5.6,"color":"#66776B","ls":1.0,"before":3.92}},{"t":"text","bind":"in_memory","x":0.2,"y":4.5,"w":1.6,"h":0.1094,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":6.3,"color":"#66776B","spc":0.0,"paras":[{"align":"c","ls":1.0,"before":0.0,"after":0.0,"font":"LAi","size":6.3,"color":"#66776B","spc":0.0,"text":"In loving memory of"}]},{"t":"text","bind":"name","x":0.2,"y":4.6294,"w":1.6,"h":0.3551,"anchor":"m","sample":"Eleanor Grace Whitfield","align":"c","ls":0.95,"font":"PF","size":9.4,"color":"#2F4034","spc":0.0,"paras":[{"align":"c","ls":0.95,"before":0.0,"after":0.0,"font":"PF","size":9.4,"color":"#2F4034","spc":0.0,"text":"Eleanor Grace Whitfield"}],"wrap":true},{"t":"text","bind":"dates","x":0.2,"y":5.0045,"w":1.6,"h":0.26,"anchor":"m","sample":"March 4, 1941 –\nSeptember 12, 2026","align":"c","ls":1.1,"font":"LA","size":6.0,"color":"#33403A","spc":0.2,"paras":[{"align":"c","ls":1.1,"before":0.0,"after":0.0,"font":"LA","size":6.0,"c