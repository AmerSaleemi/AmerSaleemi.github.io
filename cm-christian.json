them, abideth;\nthe Spirit and the gifts are ours\nthrough Him who with us sideth.\nLet goods and kindred go,\nthis mortal life also;\nthe body they may kill:\nGod’s truth abideth still;\nHis kingdom is forever.\nMartin Luther · Lutheran","align":"c","ls":1.18,"font":"LAi","size":9.6,"color":"#3E3B3F","spc":0.0,"prose":{"font":"LA","size":10.2,"color":"#3E3B3F","ls":1.3,"after":6.12},"poem":{"font":"LAi","size":9.6,"color":"#3E3B3F","ls":1.18,"stanza":5.28},"source":{"font":"LAi","size":8,"color":"#7A6D6F","ls":1.0,"before":5.6}},{"t":"text","bind":"in_memory","x":0.38,"y":4.78,"w":3.24,"h":0.1562,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":9.0,"color":"#7A6D6F","spc":0.0},{"t":"text","bind":"name","x":0.38,"y":4.9562,"w":3.24,"h":0.2456,"anchor":"m","sample":"Eleanor Grace Whitfield","align":"c","ls":0.95,"font":"PF","size":13.0,"color":"#3A383B","spc":0.0},{"t":"text","bind":"dates","x":0.38,"y":5.2218,"w":3.24,"h":0.1892,"anchor":"m","sample":"March 4, 1941 – September 12, 2026","align":"c","ls":1.1,"font":"LA","size":8.6,"color":"#3E3B3F","spc":0.2}],"bg":"cm-bg-christian-46-prot_rose-back.jpg","px":[1200,1800]}],"prot_lavender":[{"design":"prot_lavender","side":"front","w":4.0,"h":6.0,"els":[{"t":"text","bind":"kicker","x":0.2,"y":0.36,"w":3.6,"h":0.62,"anchor":"m","sample":"At Peace With the Lord","align":"c","ls":1.0,"font":"GV","size":21.67,"color":"#6E5F94","spc":0.0},{"t":"photo","bind":"photo","x":0.85,"y":1.06,"w":2.3,"h":2.8111,"border":"#9A8BC2","bw":1.0},{"t":"text","bind":"name","x":0.35,"y":4.0111,"w":3.3,"h":0.62,"anchor":"m","sample":"Eleanor Grace Whitfield","align":"c","ls":0.92,"font":"PF","size":19.0,"color":"#2F2A3D","spc":0.0},{"t":"text","bind":"dates","x":0.35,"y":4.6911,"w":3.3,"h":0.21,"anchor":"m","sample":"March 4, 1941 – September 12, 2026","align":"c","ls":1.15,"font":"LA","size":9.5,"color":"#3A3448","spc":0.2}],"bg":"cm-bg-christian-46-prot_lavender-front.jpg","px":[1200,1800]},{"design":"prot_lavender","side":"back","w":4.0,"h":6.0,"els":[{"t":"text","bind":"verse_title","x":0.2,"y":0.76,"w":3.6,"h":0.36,"anchor":"m","sample":"Nothing Can Separate Us","align":"c","ls":1.0,"font":"PF","size":15.0,"color":"#6B5B8E","spc":0.0},{"t":"verse","bind":"verse","x":0.38,"y":1.18,"w":3.24,"h":3.5,"anchor":"m","sample":"What is the chief end of man? Man’s chief end is to glorify God, and to enjoy him for ever.\nFor I am persuaded, that neither death, nor life, nor angels, nor principalities, nor powers, nor things present, nor things to come, nor height, nor depth, nor any other creature, shall be able to separate us from the love of God, which is in Christ Jesus our Lord.\nShorter Catechism · Romans 8 · Presbyterian","align":"c","ls":1.3,"font":"LA","size":10.2,"color":"#3A3448","spc":0.0,"prose":{"font":"LA","size":10.2,"color":"#3A3448","ls":1.3,"after":6.12},"poem":{"font":"LAi","size":9.6,"color":"#3A3448","ls":1.18,"stanza":5.28},"source":{"font":"LAi","size":8,"color":"#6E6880","ls":1.0,"before":5.6}},{"t":"text","bind":"in_memory","x":0.38,"y":4.78,"w":3.24,"h":0.1562,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":9.0,"color":"#6E6880","spc":0.0},{"t":"text","bind":"name","x":0.38,"y":4.9562,"w":3.24,"h":0.2456,"anchor":"m","sample":"Eleanor Grace Whitfield","align":"c","ls":0.95,"font":"PF","size":13.0,"color":"#2F2A3D","spc":0.0},{"t":"text","bind":"dates","x":0.38,"y":5.2218,"w":3.24,"h":0.1892,"anchor":"m","sample":"March 4, 1941 – September 12, 2026","align":"c","ls":1.1,"font":"LA","size":8.6,"color":"#3A3448","spc":0.2}],"bg":"cm-bg-christian-46-prot_lavender-back.jpg","px":[1200,1800]}],"prot_sky":[{"design":"prot_sky","side":"front","w":4.0,"h":6.0,"els":[{"t":"text","bind":"kicker","x":0.2,"y":0.36,"w":3.6,"h":0.62,"anchor":"m","sample":"Until We Meet Again","align":"c","ls":1.0,"font":"GV","size":23.11,"color":"#2E5A8E","spc":0.0},{"t":"photo","bind":"photo","x":0.85,"y":1.06,"w":2.3,"h":2.8111,"border":"#5E86B8","bw":1.0},{"t":"text","bind":"name","x":0.35,"y":4.0111,"w":3.3,"h":0.62,"anchor":"m","sample":"Robert James Carter","align":"c","ls":0.92,"font":"PF","size":19.0,"color":"#1F3450","spc":0.0},{"t":"text","bind":"dates","x":0.35,"y":4.6911,"w":3.3,"h":0.21,"anchor":"m","sample":"June 12, 1948 – September 10, 2026","align":"c","ls":1.15,"font":"LA","size":9.5,"color":"#2B3A4F","spc":0.2}],"bg":"cm-bg-christian-46-prot_sky-front.jpg","px":[1200,1800]},{"design":"prot_sky","side":"back","w":4.0,"h":6.0,"els":[{"t":"text","bind":"verse_title","x":0.2,"y":0.76,"w":3.6,"h":0.36,"anchor":"m","sample":"I Am the Resurrection","align":"c","ls":1.0,"font":"PF","size":15.0,"color":"#2E5A8E","spc":0.0},{"t":"verse","bind":"verse","x":0.38,"y":1.18,"w":3.24,"h":3.5,"anchor":"m","sample":"I am the resurrection and the life, saith the Lord: he that believeth in me, though he were dead, yet shall he live: and whosoever liveth and believeth in me shall never die.\nI know that my Redeemer liveth, and that he shall stand at the latter day upon the earth: and though after my skin worms destroy this body, yet in my flesh shall I see God.\nRest eternal grant unto him, O Lord; and let light perpetual shine upon him. May his soul, and the souls of all the departed, through the mercy of God, rest in peace. Amen.\nBook of Common Prayer · Episcopal","align":"c","ls":1.3,"font":"LA","size":10.2,"color":"#2B3A4F","spc":0.0,"prose":{"font":"LA","size":10.2,"color":"#2B3A4F","ls":1.3,"after":6.12},"poem":{"font":"LAi","size":9.6,"color":"#2B3A4F","ls":1.18,"stanza":5.28},"source":{"font":"LAi","size":8,"color":"#5D6D80","ls":1.0,"before":5.6}},{"t":"text","bind":"in_memory","x":0.38,"y":4.78,"w":3.24,"h":0.1562,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":9.0,"color":"#5D6D80","spc":0.0},{"t":"text","bind":"name","x":0.38,"y":4.9562,"w":3.24,"h":0.2456,"anchor":"m","sample":"Robert James Carter","align":"c","ls":0.95,"font":"PF","size":13.0,"color":"#1