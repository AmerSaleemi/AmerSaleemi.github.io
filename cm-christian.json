longer my own, but thine. Put me to what thou wilt, rank me with whom thou wilt. Put me to doing, put me to suffering. Let me be employed for thee or laid aside for thee, exalted for thee or brought low for thee. Let me be full, let me be empty. Let me have all things, let me have nothing. I freely and heartily yield all things to thy pleasure and disposal.\nAnd now, O glorious and blessed God, Father, Son and Holy Spirit, thou art mine, and I am thine. So be it. Amen.\nJohn Wesley · Methodist","align":"c","ls":1.3,"font":"LA","size":7.0,"color":"#343E32","spc":0.0,"prose":{"font":"LA","size":7.0,"color":"#343E32","ls":1.3,"after":4.2},"poem":{"font":"LAi","size":6.75,"color":"#343E32","ls":1.18,"stanza":3.71},"source":{"font":"LAi","size":5.8,"color":"#68725E","ls":1.0,"before":4.06}},{"t":"text","bind":"in_memory","x":0.24,"y":3.4,"w":2.02,"h":0.1094,"anchor":"m","sample":"In loving memory of","align":"c","ls":1.0,"font":"LAi","size":6.3,"color":"#68725E","spc":0.0},{"t":"text","bind":"name","x":0.24,"y":3.5294,"w":2.02,"h":0.1738,"anchor":"m","sample":"Robert James Carter","align":"c","ls":0.95,"font":"PF","size":9.2,"color":"#2F3A2C","spc":0.0},{"t":"text","bind":"dates","x":0.24,"y":3.7232,"w":2.02,"h":0.1392,"anchor":"m","sample":"June 12, 1948 – September 10, 2026","align":"c","ls":1.1,"font":"LA","size":6.2,"color":"#343E32","spc":0.2}],"bg":"cm-bg-christian-25-prot_sage-back.jpg","px":[750,1275]}],"prot_rose":[{"design":"prot_rose","side":"front","w":2.5,"h":4.25,"els":[{"t":"text","bind":"kicker","x":0.15,"y":0.24,"w":2.2,"h":0.44,"anchor":"m","sample":"Forever Loved","align":"c","ls":1.0,"font":"GV","size":18.89,"color":"#A86F6F","spc":0.0},{"t":"photo","bind":"photo","x":0.52,"y":0.72,"w":1.46,"h":1.7844,"border":"#C4908E","bw":0.75},{"t":"text","bind":"name","x":0.22,"y":2.6044,"w":2.06,"h":0.44,"anchor":"m","sample":"Eleanor Grace Whitfield","align":"c","ls":0.92,"font":"PF","size":12.5,"color":"#3A383B","spc":0.0},{"t":"text","bind":"dates","x":0.22,"