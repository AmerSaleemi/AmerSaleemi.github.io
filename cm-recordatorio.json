 me dan aliento. Preparas una mesa ante mí frente a mis adversarios; unges mi cabeza con aceite; mi copa rebosa. Ciertamente la bondad y la misericordia me acompañarán todos los días de mi vida, y en la casa del Señor habitaré para siempre.\nSalmo 23","align":"c","ls":1.3,"font":"LA","size":7.0,"color":"#2C3650","spc":0.0,"prose":{"font":"LA","size":7.0,"color":"#2C3650","ls":1.3,"after":4.2},"poem":{"font":"LAi","size":6.75,"color":"#2C3650","ls":1.18,"stanza":3.71},"source":{"font":"LAi","size":5.8,"color":"#5F6882","ls":1.0,"before":4.06}},{"t":"text","bind":"in_memory","x":0.24,"y":3.4,"w":2.02,"h":0.1094,"anchor":"m","sample":"En memoria de","align":"c","ls":1.0,"font":"LAi","size":6.3,"color":"#5F6882","spc":0.0},{"t":"text","bind":"name","x":0.24,"y":3.5294,"w":2.02,"h":0.1738,"anchor":"m","sample":"María Elena Ramírez Torres","align":"c","ls":0.95,"font":"PF","size":9.2,"color":"#1E2A44","spc":0.0},{"t":"text","bind":"dates","x":0.24,"y":3.7232,"w":2.02,"h":0.2683,"anchor":"m","sample":"4 de marzo de 1941 –\n12 de septiembre de 2026","align":"c","ls":1.1,"font":"LA","size":6.2,"color":"#2C3650","spc":0.2}],"bg":"cm-bg-recordatorio-25-navy-back.jpg","px":[750,1275]}],"sage":[{"design":"sage","side":"front","w":2.5,"h":4.25,"els":[{"t":"text","bind":"kicker","x":0.15,"y":0.24,"w":2.2,"h":0.44,"anchor":"m","sample":"Celebración de vida","align":"c","ls":1.0,"font":"GV","size":17.94,"color":"#5A7A62","spc":0.0},{"t":"photo","bind":"photo","x":0.52,"y":0.72,"w":1.46,"h":1.7844,"border":"#86A382","bw":0.75},{"t":"text","bind":"name","x":0.22,"y":2.6044,"w":2.06,"h":0.44,"anchor":"m","sample":"María Elena Ramírez Torres","align":"c","ls":0.92,"font":"PF","size":12.5,"color":"#2F4034","spc":0.0},{"t":"text","bind":"dates","x":0.22,"y":3.0844,"w":2.06,"h":0.27,"anchor":"m","sample":"4 de marzo de 1941 –\n12 de septiembre de 2026","align":"c","ls":1.15,"font":"LA","size":6.8,"color":"#33403A","spc":0.2}],"bg":"cm-bg-recordatorio-25-sage-front.jpg","px":[750,1275]},{"d