align":"c","ls":1.0,"font":"PF","size":15.0,"color":"#1E2A44","spc":0.0},{"t":"verse","bind":"verse","x":0.38,"y":1.18,"w":3.24,"h":3.5,"anchor":"m","sample":"El Señor es mi pastor; nada me faltará. En verdes praderas me hace descansar; junto a aguas tranquilas me conduce. Reconforta mi alma; me guía por senderos de justicia por amor de su nombre. Aunque camine por el valle de sombra de muerte, no temeré mal alguno, porque tú estás conmigo; tu vara y tu cayado me dan aliento. Preparas una mesa ante mí frente a mis adversarios; unges mi cabeza con aceite; mi copa rebosa. Ciertamente la bondad y la misericordia me acompañarán todos los días de mi vida, y en la casa del Señor habitaré para siempre.\nSalmo 23","align":"c","ls":1.3,"font":"LA","size":10.2,"color":"#2C3650","spc":0.0,"prose":{"font":"LA","size":10.2,"color":"#2C3650","ls":1.3,"after":6.12},"poem":{"font":"LAi","size":9.6,"color":"#2C3650","ls":1.18,"stanza":5.28},"source":{"font":"LAi","size":8,"color":"#5F6882","ls":1.0,"before":5.6}},{"t":"text","bind":"in_memory","x":0.38,"y":4.78,"w":3.24,"h":0.1562,"anchor":"m","sample":"En memoria de","align":"c","ls":1.0,"font":"LAi","size":9.0,"color":"#5F6882","spc":0.0},{"t":"text","bind":"name","x":0.38,"y":4.9562,"w":3.24,"h":0.2456,"anchor":"m","sample":"María Elena Ramírez Torres","align":"c","ls":0.95,"font":"PF","size":13.0,"color":"#1E2A44","spc":0.0},{"t":"text","bind":"dates","x":0.38,"y":5.2218,"w":3.24,"h":0.3683,"anchor":"m","sample":"4 de marzo de 1941 –\n12 de septiembre de 2026","align":"c","ls":1.1,"font":"LA","size":8.6,"color":"#2C3650","spc":0.2}],"bg":"cm-bg-recordatorio-46-navy-back.jpg","px":[1200,1800]}],"sage":[{"design":"sage","side":"front","w":4.0,"h":6.0,"els":[{"t":"text","bind":"kicker","x":0.2,"y":0.36,"w":3.6,"h":0.62,"anchor":"m","sample":"Celebración de vida","align":"c","ls":1.0,"font":"GV","size":27.44,"color":"#5A7A62","spc":0.0},{"t":"photo","bind":"photo","x":0.85,"y":1.06,"w":2.3,"h":2.8111,"border":"#86A382","bw":1.0},{"t":"text","bind":"name","x":0.35,"y":4.0111,"w":3.3,"h":0.68,"anchor":"m","sample":"María Elena Ramírez Torres","align":"c","ls":0.92,"font":"PF","size":19.0,"color":"#2F4034","spc":0.0},{"t":"text","bind":"dates","x":0.35,"y":4.7511,"w":3.3,"h":0.37,"anchor":"m","sample":"4 de marzo de 1941 –\n12 de septiembre de 2026","align":"c","ls":1.15,"font":"LA","size":9.5,"color":"#33403A","spc":0.2}],"bg":"cm-bg-recordatorio-46-sage-front.jpg","px":[1200,1800]},{"design":"sage","side":"back","w":4.0,"h":6.0,"els":[{"t":"text","bind":"verse_title","x":0.2,"y":0.76,"w":3.6,"h":0.36,"anchor":"m","sample":"En paz","align":"c","ls":1.0,"font":"PF","size":15.0,"color":"#51705A","spc":0.0},{"t":"verse","bind":"verse","x":0.38,"y":1.18,"w":3.24,"h":3.5,"anchor":"m","sample":"Muy cerca de mi ocaso, yo te bendigo, Vida,\nporque nunca me diste ni esperanza fallida,\nni trabajos injustos, ni pena inmerecida;\nporque veo al final de mi rudo camino\nque yo fui el arquitecto de mi propio destino;\nAmé, fui amado, el sol acarició mi faz.\n¡Vida, nada me debes! ¡Vida, estamos en paz!\nAmado Nervo (fragmento)","align":"c","ls":1.18,"font":"LAi","size":9.6,"color":"#33403A","spc":0.0,"prose":{"font":"LA","size":10.2,"color":"#33403A","ls":1.3,"after":6.12},"poem":{"font":"LAi","size":9.6,"color":"#33403A","ls":1.18,"stanza":5.28},"source":{"font":"LAi","size":8,"color":"#66776B","ls":1.0,"before":5.6}},{"t":"text","bind":"in_memory","x":0.38,"y":4.78,"w":3.24,"h":0.1562,"anchor":"m","sample":"En memoria de","align":"c","ls":1.0,"font":"LAi","size":9.0,"color":"#66776B","spc":0.0},{"t":"text","bind":"name","x":0.38,"y":4.9562,"w":3.24,"h":0.2456,"anchor":"m","sample":"María Elena Ramírez Torres","align":"c","ls":0.95,"font":"PF","size":13.0,"color":"#2F4034","spc":0.0},{"t":"text","bind":"dates","x":0.38,"y":5.2218,"w":3.24,"h":0.3683,"anchor":"m","sample":"4 de marzo de 1941 –\n12 de septiembre de 2026","align":"c","ls":1.1,"font":"LA","size":8.6,"color":"#33403A","spc":0.2}],"bg":"cm-bg-reco